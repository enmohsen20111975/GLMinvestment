# ============================================================
# Environment Variables — Sandbox (Cloud Sandbox Environment)
# ملف نظيف — لا يوجد أي مفاتيح حقيقية أو بيانات اعتماد إنتاج
# كل القيم الحساسة مماثلة (placeholders) أو فارغة
# المسارات نسبية فقط (لا مسارات مطلقة)
# ============================================================

# ==================== Application Core ====================
NODE_ENV=development
ENVIRONMENT=development
APP_NAME=Investment Platform
APP_VERSION=3.4.41
DEBUG=true

# ==================== Database (relative path) ====================
# القاعدة: المسار نسبي — يشير إلى db/auth.db (قاعدة بيانات المصادقة)
DATABASE_URL="file:./db/auth.db"

# ==================== Authentication & Domain ====================
# NEXTAUTH_SECRET: قيمة تجريبية للساندبوكس فقط (وليس سر الإنتاج)
NEXTAUTH_SECRET=sandbox_nextauth_dev_secret_placeholder_only
NEXTAUTH_URL=http://localhost:3000
MAIN_DOMAIN=http://localhost:3000

# ADMIN: قيم افتراضية للساندبوكس (غيّرها قبل أي نشر)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sandbox_admin_change_me
ADMIN_SESSION_TOKEN=sandbox_admin_session_token_placeholder

# ==================== Google OAuth Credentials ====================
# مماثلة (placeholders) — لا مفاتيح حقيقية في الساندبوكس
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_ANDROID_CLIENT_IDS=
SHARED_SECRET=sandbox_shared_secret_only

# ==================== Python Backend Service ====================
PYTHON_BACKEND_URL=http://localhost:8010
EGXPY_SERVICE_URL=http://localhost:8010

# ==================== Paymob Payment Gateway ====================
# مماثلة (placeholders) — لا مفاتيح دفع حقيقية في الساندبوكس
PAYMOB_MODE=test
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
PAYMOB_CURRENCY=EGP
PAYMOB_WEBHOOK_URL=
PAYMOB_REDIRECT_URL=

# Plan Prices (in piastres - 1 EGP = 100 piastres)
PAYMOB_PLAN_NORMAL_MONTHLY_PRICE=19900
PAYMOB_PLAN_NORMAL_YEARLY_PRICE=199000
PAYMOB_PLAN_PREMIUM_MONTHLY_PRICE=29900
PAYMOB_PLAN_PREMIUM_YEARLY_PRICE=299000
PAYMOB_PLAN_DEVELOPER_MONTHLY_PRICE=49900
PAYMOB_PLAN_DEVELOPER_YEARLY_PRICE=499000

# ==================== Telegram Integration ====================
# مماثلة (placeholders) — لا توكنز حقيقية في الساندبوكس
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_GROUP=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_App_title=
TELEGRAM_Short_name=

# ==================== Local AI Engine (Ollama/LM Studio) ====================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=glm-fast:latest
LOCAL_AI_MODEL=glm-fast:latest
OLLAMA_DEEP_MODEL=glm-fast:latest
LM_STUDIO_URL=http://localhost:1234

# ==================== Scheduler & Market Trading Hours ====================
SCHEDULER_ENABLED=true
DATA_UPDATE_INTERVAL_MINUTES=5
DELAYED_DATA_MINUTES=5
TRADING_START_HOUR=10
TRADING_END_HOUR=15
TRADING_DAYS=0,1,2,3,4

# ==================== External Financial APIs (Placeholders) ====================
TWELVE_DATA_API_KEY=
EODHD_API_KEY=
NEWSAPI_KEY=
GNEWS_KEY=
