# ============================================================================
# GLMinvestment — Environment Variables Template
# ============================================================================
# P0-AUDIT-H FIX (2026-10-14): Created .env.example for deployment onboarding.
#
# Copy this file to `.env` (development) or `.env.production` (production)
# and fill in the real values. NEVER commit real secrets to git.
#
# See AUDIT_REPORT_FULL.md (Section 8.6) for the full env var inventory.
# ============================================================================

# ─── Database ──────────────────────────────────────────────────────────────
# SQLite path (canonical). Use absolute path in production.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ─── NextAuth (CRITICAL — app won't start without these) ────────────────────
# Generate a random 32+ char secret: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_TO_RANDOM_32_CHAR_SECRET"
# MUST start with https:// in production for secure cookies
NEXTAUTH_URL="https://invist.m2y.net"

# ─── Google OAuth ───────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="CHANGE_ME.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="CHANGE_ME"

# ─── Sentry (optional but recommended) ─────────────────────────────────────
# Get from: https://sentry.io/settings/projects/<your-project>/keys/
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Backend services ──────────────────────────────────────────────────────
PYTHON_BACKEND_URL="http://127.0.0.1:8010"
DATA_ENGINE_URL="http://localhost:5000"

# ─── Admin authentication ──────────────────────────────────────────────────
# Leave unset in production for maximum security (fail-closed).
ALLOW_FORM_LOGIN="false"
ALLOW_ADMIN_BYPASS="false"
# Admin credentials (used by /api/admin/auth route + test_stats.js)
ADMIN_USERNAME="CHANGE_ME"
ADMIN_PASSWORD="CHANGE_ME_TO_STRONG_PASSWORD"
ADMIN_EMAIL="admin@example.com"
# Comma-separated list of admin emails (overrides hardcoded defaults)
ADMIN_EMAILS="admin@example.com"
ADMIN_USERNAMES="admin"
# Static admin session token (should be random per deployment)
ADMIN_SESSION_TOKEN="CHANGE_ME_TO_RANDOM_TOKEN"

# ─── Telegram Bot ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_CHANNEL_ID=""
BOT_API_SECRET="CHANGE_ME_TO_RANDOM_SECRET"

# ─── DeepSeek AI (CRIT-1 FIX — no more hardcoded fallback) ──────────────────
# Required for news enrichment. If unset, rule_based_fallback will be used.
DEEPSEEK_KEY=""

# ─── Payment providers ────────────────────────────────────────────────────
# Paymob
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
# Instapay
INSTAPAY_ACCOUNT=""

# ─── External data APIs ────────────────────────────────────────────────────
EODHD_API_KEY=""

# ─── Public URLs ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_SENTRY_DSN=""
MAIN_DOMAIN="https://m2y.net"
M2Y_API_URL="https://m2y.net"

# ─── News Agent ─────────────────────────────────────────────────────────────
PRODUCTION_SERVER_URL=""
OLLAMA_MODEL=""
COLLECTION_INTERVAL_MINUTES="30"
MIN_IMPORTANCE_SCORE="0.5"
MAX_NEWS_PER_BATCH="20"
ENABLE_EGYPTIAN_SOURCES="true"

# ─── Node runtime ──────────────────────────────────────────────────────────
NODE_ENV="production"
# Adjust based on available memory (256 too low for Next.js 14, use 1024+)
UV_THREADPOOL_SIZE="2"
SWC_THREADPOOL="1"
RAYON_NUM_THREADS="1"

# ─── Development only (set to false in production) ─────────────────────────
# When true, allows credentials-based login (insecure in production)
# ALLOW_FORM_LOGIN defaults to "false" — leave it false in production.
