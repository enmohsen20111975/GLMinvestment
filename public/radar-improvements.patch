+    explosive_list = [r for r in under_microscope_raw if r['path'] in ('D_explosive_surge', 'B_explosive_surge')]
+    early_break_list = [r for r in under_microscope_raw if r['path'] in ('E_early_break', 'C_early_break')]
+
