+
+    # تقرير عربي
+    report = build_arabic_report(results, under_microscope, quiet_list, explosive_list, early_break_list)
+    md_path = OUTPUT_DIR / f"maker_radar_{today_str}.md"
+    with open(md_path, "w", encoding="utf-8") as f:
