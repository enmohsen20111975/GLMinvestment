#!/usr/bin/env bash
# pre-commit hook — DEV-14 §4: run check:guards before allowing a commit.
#
# Blocks the commit if any ACTIVE `DELETE FROM predictions` or
# `INSERT INTO predictions` (outside canonical writer) is found.
#
# Install (one-time, after clone):
#   chmod +x .git/hooks/pre-commit
#   # OR
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Bypass (one-time, when intentionally adding a guarded INSERT/DELETE):
#   git commit --no-verify
#
# References:
#   - agent-ctx/DEV-11-14-lead-technical-implementer.md §4
#   - worklog.md DEV-14
set -e

# Resolve repo root (the hook runs with cwd = repo root, but be defensive).
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-commit] Running check:guards (DEV-14 §4)..."

# Run both guard checks. If either fails, the commit is aborted.
python3 scripts/check_no_hard_delete.py
python3 scripts/check_no_raw_insert.py

echo "[pre-commit] ✓ All guards passed — proceeding with commit."
exit 0
