     1→//@version=5
     2→indicator("محرك القرار المؤسسي V55 - EGX PRO Money Flow (Clean Chart)", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)
     3→
     4→// ============================================================================ 
     5→// 1) SETTINGS
     6→// ============================================================================ 
     7→
     8→group_market = "🇪🇬 السوق"
     9→market_type = input.string("EGX", "السوق", options=["EGX", "Global"], group=group_market)
    10→benchmark_ticker = input.symbol("EGX:EGX30", "مؤشر السوق", group=group_market)
    11→sector_benchmark = input.symbol("", "مؤشر القطاع - اختياري", group=group_market)
    12→
    13→group_mode = "🧠 المحرك الذكي"
    14→trade_mode = input.string("متوازن", "نمط التداول", options=["حذر", "متوازن", "هجومي"], group=group_mode)
    15→
    16→group_visual = "🎨 الشكل"
    17→show_levels = input.bool(false, "إظهار الدعم والمقاومة", group=group_visual) // تم الإغلاق افتراضياً
    18→show_vw_sr = input.bool(false, "إظهار الدعوم/المقاومات الحجمية", group=group_visual) // تم الإغلاق افتراضياً
    19→show_fair = input.bool(false, "إظهار القيمة العادلة", group=group_visual) // تم الإغلاق افتراضياً
    20→show_poc = input.bool(false, "إظهار POC", group=group_visual) // تم الإغلاق افتراضياً
    21→show_makers = input.bool(true, "إظهار إشارات الميكرز", group=group_visual)
    22→show_dna = input.bool(true, "إظهار البصمة المتصلة (3 DNA)", group=group_visual)
    23→show_reason = input.bool(true, "إظهار التعليق التحليلي", group=group_visual)
    24→
    25→group_flow = "💰 Money Flow"
    26→show_money_flow = input.bool(true, "إظهار تحليل الشراء والبيع", group=group_flow)
    27→flow_strong_threshold = input.float(60.0, "نسبة السيولة القوية %", minval=50, maxval=90, step=1, group=group_flow)
    28→flow_volume_threshold = input.float(1.20, "مضاعف الحجم لتأكيد السيولة", minval=1.0, maxval=5.0, step=0.05, group=group_flow)
    29→
    30→group_risk = "💰 إدارة المخاطر"
    31→account_balance = input.float(10000, "رأس المال", minval=0, group=group_risk)
    32→risk_percent = input.float(1.0, "المخاطرة الأساسية %", minval=0.1, maxval=5, step=0.1, group=group_risk)
    33→
    34→group_calc = "⚙️ الحسابات"
    35→rsi_length = input.int(14, "RSI", minval=2, group=group_calc)
    36→atr_length = input.int(14, "ATR", minval=2, group=group_calc)
    37→pivot_length = input.int(5, "Pivot Length", minval=2, maxval=20, group=group_calc)
    38→
    39→// ============================================================================ 
    40→// 2) COLORS
    41→// ============================================================================ 
    42→
    43→color bg_main = color.rgb(12, 18, 28)
    44→color bg_header = color.rgb(0, 75, 105)
    45→color bg_section = color.rgb(25, 35, 50)
    46→color bg_cell = color.rgb(18, 27, 39)
    47→
    48→color bull_color = color.rgb(0, 210, 110)
    49→color bear_color = color.rgb(245, 65, 75)
    50→color neutral_color = color.rgb(170, 175, 185)
    51→
    52→color yellow_color = color.rgb(255, 190, 50)
    53→color orange_color = color.rgb(255, 135, 35)
    54→color cyan_color = color.rgb(0, 200, 220)
    55→color purple_color = color.rgb(175, 90, 240)
    56→color white_color = color.white
    57→
    58→// ============================================================================ 
    59→// 3) BASIC DATA
    60→// ============================================================================ 
    61→
    62→float atr = ta.atr(atr_length)
    63→float rsi = ta.rsi(close, rsi_length)
    64→
    65→float ema20 = ta.ema(close, 20)
    66→float ema50 = ta.ema(close, 50)
    67→float ema200 = ta.ema(close, 200)
    68→
    69→float vol_ma = ta.sma(volume, 20)
    70→float vol_std = ta.stdev(volume, 20)
    71→float volume_ratio = vol_ma > 0 ? volume / vol_ma : 0
    72→
    73→bool volume_strong = volume_ratio >= 1.30
    74→bool volume_extreme = volume_ratio >= 2.00
    75→
    76→float stock_roc_14 = ta.roc(close, 14)
    77→
    78→bool trend_bull = close > ema20 and ema20 > ema50 and ema50 > ema200
    79→bool trend_bear = close < ema20 and ema20 < ema50 and ema50 < ema200
    80→
    81→// ============================================================================ 
    82→// 4) MARKET & PIVOT BENCHMARK
    83→// ============================================================================ 
    84→
    85→[market_close, market_roc] = request.security(benchmark_ticker, timeframe.period, [close, ta.roc(close, 14)], barmerge.gaps_off, barmerge.lookahead_off)
    86→float relative_market_strength = stock_roc_14 - nz(market_roc)
    87→bool outperform_market = relative_market_strength > 0
    88→
    89→[prev_day_high, prev_day_low, prev_day_close] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_off)
    90→float pivot = (prev_day_high + prev_day_low + prev_day_close) / 3.0
    91→
    92→float r1 = 2.0 * pivot - prev_day_low
    93→float r2 = pivot + (prev_day_high - prev_day_low)
    94→float r3 = prev_day_high + 2.0 * (pivot - prev_day_low)
    95→
    96→float s1 = 2.0 * pivot - prev_day_high
    97→float s2 = pivot - (prev_day_high - prev_day_low)
    98→float s3 = prev_day_low - 2.0 * (prev_day_high - pivot)
    99→
   100→bool above_pivot = close > pivot
   101→string pivot_state = above_pivot ? "🟢 إيجابي" : "🔴 سلبي"
   102→
   103→// ============================================================================ 
   104→// 5) SECTOR / INDUSTRY
   105→// ============================================================================ 
   106→
   107→string auto_sector = syminfo.sector
   108→string sector_name = na(auto_sector) or auto_sector == "" ? "غير محدد" : auto_sector
   109→
   110→string auto_industry = syminfo.industry
   111→string industry_name = na(auto_industry) or auto_industry == "" ? "غير محدد" : auto_industry
   112→
   113→bool has_sector = sector_benchmark != ""
   114→string sec_sym = has_sector ? sector_benchmark : syminfo.tickerid
   115→
   116→[sec_close, sec_vol, sec_vol_ma] = request.security(sec_sym, timeframe.period, [close, volume, ta.sma(volume, 20)], barmerge.gaps_off, barmerge.lookahead_off)
   117→
   118→float sector_close = has_sector ? sec_close : na
   119→float sector_roc = has_sector ? ta.roc(sector_close, 14) : na
   120→float stock_vs_sector = has_sector ? stock_roc_14 - nz(sector_roc) : na
   121→
   122→float sector_ema20 = has_sector ? ta.ema(sector_close, 20) : na
   123→
   124→bool sector_bull = has_sector and sector_roc > 0 and sector_close > sector_ema20
   125→bool sector_bear = has_sector and sector_roc < 0 and sector_close < sector_ema20
   126→
   127→float sector_volume_ratio = has_sector and sec_vol_ma > 0 ? sec_vol / sec_vol_ma : na
   128→
   129→bool sector_money_in = has_sector and sector_volume_ratio >= 1.20 and sector_roc > 0
   130→bool sector_money_out = has_sector and sector_volume_ratio >= 1.20 and sector_roc < 0
   131→
   132→string sector_state = "⚪ غير متاح"
   133→if has_sector
   134→    if sector_money_in
   135→        sector_state := "🟢 سيولة داخلة"
   136→    else if sector_money_out
   137→        sector_state := "🔴 سيولة خارجة"
   138→    else if sector_bull
   139→        sector_state := "🟢 صاعد"
   140→    else if sector_bear
   141→        sector_state := "🔴 هابط"
   142→    else
   143→        sector_state := "🟡 عرضي"
   144→
   145→// ============================================================================ 
   146→// 6) RSI STATE
   147→// ============================================================================ 
   148→
   149→string rsi_state = "محايد"
   150→color rsi_color = neutral_color
   151→
   152→if rsi >= 70
   153→    rsi_state := "تشبع شراء"
   154→    rsi_color := orange_color
   155→else if rsi >= 55
   156→    rsi_state := "إيجابي"
   157→    rsi_color := bull_color
   158→else if rsi <= 30
   159→    rsi_state := "تشبع بيع"
   160→    rsi_color := purple_color
   161→else if rsi < 45
   162→    rsi_state := "سلبي"
   163→    rsi_color := bear_color
   164→else
   165→    rsi_state := "محايد"
   166→    rsi_color := neutral_color
   167→
   168→// ============================================================================ 
   169→// 7) SWING SUPPORT / RESISTANCE & VOLUME-WEIGHTED SR
   170→// ============================================================================ 
   171→
   172→float swing_high = ta.pivothigh(high, pivot_length, pivot_length)
   173→float swing_low = ta.pivotlow(low, pivot_length, pivot_length)
   174→
   175→var float last_resistance = na
   176→var float last_support = na
   177→
   178→if not na(swing_high)
   179→    last_resistance := swing_high
   180→
   181→if not na(swing_low)
   182→    last_support := swing_low
   183→
   184→var float[] res_prices = array.new_float()
   185→var float[] res_vols = array.new_float()
   186→var float[] sup_prices = array.new_float()
   187→var float[] sup_vols = array.new_float()
   188→
   189→if not na(swing_high)
   190→    array.push(res_prices, swing_high)
   191→    array.push(res_vols, volume[pivot_length])
   192→    if array.size(res_prices) > 50
   193→        array.shift(res_prices)
   194→        array.shift(res_vols)
   195→
   196→if not na(swing_low)
   197→    array.push(sup_prices, swing_low)
   198→    array.push(sup_vols, volume[pivot_length])
   199→    if array.size(sup_prices) > 50
   200→        array.shift(sup_prices)
   201→        array.shift(sup_vols)
   202→
   203→float vw_res1 = na
   204→float vw_res2 = na
   205→float vw_res3 = na
   206→float vw_res1_dist = 1e10
   207→float vw_res2_dist = 1e10
   208→float vw_res3_dist = 1e10
   209→
   210→if array.size(res_prices) > 0
   211→    for i = 0 to array.size(res_prices) - 1
   212→        float p = array.get(res_prices, i)
   213→        if p > close
   214→            float dist = p - close
   215→            if dist < vw_res1_dist
   216→                vw_res3 := vw_res2
   217→                vw_res3_dist := vw_res2_dist
   218→                vw_res2 := vw_res1
   219→                vw_res2_dist := vw_res1_dist
   220→                vw_res1 := p
   221→                vw_res1_dist := dist
   222→            else if dist < vw_res2_dist
   223→                vw_res3 := vw_res2
   224→                vw_res3_dist := vw_res2_dist
   225→                vw_res2 := p
   226→                vw_res2_dist := dist
   227→            else if dist < vw_res3_dist
   228→                vw_res3 := p
   229→                vw_res3_dist := dist
   230→
   231→float vw_sup1 = na
   232→float vw_sup2 = na
   233→float vw_sup3 = na
   234→float vw_sup1_dist = 1e10
   235→float vw_sup2_dist = 1e10
   236→float vw_sup3_dist = 1e10
   237→
   238→if array.size(sup_prices) > 0
   239→    for i = 0 to array.size(sup_prices) - 1
   240→        float p = array.get(sup_prices, i)
   241→        if p < close
   242→            float dist = close - p
   243→            if dist < vw_sup1_dist
   244→                vw_sup3 := vw_sup2
   245→                vw_sup3_dist := vw_sup2_dist
   246→                vw_sup2 := vw_sup1
   247→                vw_sup2_dist := vw_sup1_dist
   248→                vw_sup1 := p
   249→                vw_sup1_dist := dist
   250→            else if dist < vw_sup2_dist
   251→                vw_sup3 := vw_sup2
   252→                vw_sup3_dist := vw_sup2_dist
   253→                vw_sup2 := p
   254→                vw_sup2_dist := dist
   255→            else if dist < vw_sup3_dist
   256→                vw_sup3 := p
   257→                vw_sup3_dist := dist
   258→
   259→float nearest_res = vw_res1
   260→float nearest_sup = vw_sup1
   261→
   262→// ============================================================================ 
   263→// 8) VOLUME / LIQUIDITY
   264→// ============================================================================ 
   265→
   266→float dynamic_volume_level = vol_ma + nz(vol_std) * 1.5
   267→bool volume_surge = volume > dynamic_volume_level
   268→bool volume_increasing = volume > vol_ma
   269→
   270→string liquidity_state = "⚪ عادية"
   271→if volume_extreme and close > open
   272→    liquidity_state := "🟢 سيولة قوية داخلة"
   273→else if volume_extreme and close < open
   274→    liquidity_state := "🔴 سيولة قوية خارجة"
   275→else if volume_surge and close > open
   276→    liquidity_state := "🟢 دخول سيولة"
   277→else if volume_surge and close < open
   278→    liquidity_state := "🔴 خروج سيولة"
   279→else if volume_increasing
   280→    liquidity_state := "🟡 مرتفعة"
   281→else
   282→    liquidity_state := "⚪ عادية"
   283→
   284→// ============================================================================ 
   285→// 8.1) ESTIMATED BUY / SELL MONEY FLOW
   286→// ============================================================================ 
   287→
   288→float flow_range = math.max(high - low, syminfo.mintick)
   289→
   290→float clv = ((close - low) - (high - close)) / flow_range
   291→clv := math.max(-1.0, math.min(1.0, clv))
   292→
   293→float body_pressure = (close - open) / flow_range
   294→body_pressure := math.max(-1.0, math.min(1.0, body_pressure))
   295→
   296→float pressure_score = clv * 0.65 + body_pressure * 0.35
   297→pressure_score := math.max(-1.0, math.min(1.0, pressure_score))
   298→
   299→float estimated_buy_volume = volume * (0.5 + pressure_score * 0.5)
   300→float estimated_sell_volume = volume - estimated_buy_volume
   301→
   302→estimated_buy_volume := math.max(0, estimated_buy_volume)
   303→estimated_sell_volume := math.max(0, estimated_sell_volume)
   304→
   305→float buy_volume_pct = volume > 0 ? estimated_buy_volume / volume * 100 : 50
   306→float sell_volume_pct = volume > 0 ? estimated_sell_volume / volume * 100 : 50
   307→
   308→float estimated_buy_value_m = estimated_buy_volume * close / 1000000
   309→float estimated_sell_value_m = estimated_sell_volume * close / 1000000
   310→float estimated_total_value_m = estimated_buy_value_m + estimated_sell_value_m
   311→float net_flow_m = estimated_buy_value_m - estimated_sell_value_m
   312→float buy_sell_ratio = estimated_sell_volume > 0 ? estimated_buy_volume / estimated_sell_volume : 999.0
   313→
   314→float buy_value_ma_m = ta.sma(estimated_buy_value_m, 20)
   315→float sell_value_ma_m = ta.sma(estimated_sell_value_m, 20)
   316→float avg_total_value_m = ta.sma(estimated_total_value_m, 20)
   317→float money_volume_ratio = avg_total_value_m > 0 ? estimated_total_value_m / avg_total_value_m : 1.0
   318→
   319→bool strong_money_in = buy_volume_pct >= flow_strong_threshold and money_volume_ratio >= flow_volume_threshold and net_flow_m > 0
   320→bool strong_money_out = sell_volume_pct >= flow_strong_threshold and money_volume_ratio >= flow_volume_threshold and net_flow_m < 0
   321→
   322→bool money_in = buy_volume_pct >= 55 and net_flow_m > 0
   323→bool money_out = sell_volume_pct >= 55 and net_flow_m < 0
   324→
   325→string money_flow_state = "⚪ متوازنة"
   326→color money_flow_color = neutral_color
   327→
   328→if strong_money_in
   329→    money_flow_state := "🔥 دخول سيولة قوي"
   330→    money_flow_color := bull_color
   331→else if strong_money_out
   332→    money_flow_state := "🔥 خروج سيولة قوي"
   333→    money_flow_color := bear_color
   334→else if money_in
   335→    money_flow_state := "🟢 سيولة داخلة"
   336→    money_flow_color := bull_color
   337→else if money_out
   338→    money_flow_state := "🔴 سيولة خارجة"
   339→    money_flow_color := bear_color
   340→else
   341→    money_flow_state := "⚪ متوازنة"
   342→    money_flow_color := neutral_color
   343→
   344→// ============================================================================ 
   345→// 9) MAKER / SMART MONEY
   346→// ============================================================================ 
   347→
   348→float candle_range = high - low
   349→float upper_wick = high - math.max(open, close)
   350→float lower_wick = math.min(open, close) - low
   351→
   352→bool absorption = candle_range > 0 and close < open and lower_wick > candle_range * 0.50 and volume_surge
   353→bool distribution = candle_range > 0 and close > open and upper_wick > candle_range * 0.50 and volume_surge
   354→
   355→bool sweep_low = not na(last_support) and low < last_support and close > last_support
   356→bool sweep_high = not na(last_resistance) and high > last_resistance and close < last_resistance
   357→
   358→bool maker_bull = absorption or sweep_low
   359→bool maker_bear = distribution or sweep_high
   360→
   361→string maker_state = "⚪ محايد"
   362→if maker_bull
   363→    maker_state := "🟢 تجميع"
   364→else if maker_bear
   365→    maker_state := "🔴 تصريف"
   366→
   367→// ============================================================================ 
   368→// 10) BOLLINGER SQUEEZE
   369→// ============================================================================ 
   370→
   371→[bb_mid, bb_up, bb_low] = ta.bb(close, 20, 2.0)
   372→float bb_width = bb_mid != 0 ? ((bb_up - bb_low) / bb_mid) * 100 : 0
   373→float bb_width_avg = ta.sma(bb_width, 50)
   374→float bb_width_std = ta.stdev(bb_width, 50)
   375→
   376→bool squeeze = bb_width < bb_width_avg - nz(bb_width_std)
   377→bool expansion = bb_width > bb_width_avg + nz(bb_width_std)
   378→
   379→string volatility_state = "طبيعي"
   380→if expansion
   381→    volatility_state := "⚡ انفراج"
   382→else if squeeze
   383→    volatility_state := "😴 ضغط"
   384→else
   385→    volatility_state := "طبيعي"
   386→
   387→// ============================================================================ 
   388→// 11) FAIR VALUE & POC
   389→// ============================================================================ 
   390→
   391→float total_volume = math.sum(volume, 100)
   392→float weighted_price = math.sum(hlc3 * volume, 100)
   393→float fair_value = total_volume > 0 ? weighted_price / total_volume : close
   394→float fair_premium = fair_value > 0 ? ((close - fair_value) / fair_value) * 100 : 0
   395→
   396→string fair_state = "عادل"
   397→if fair_premium > 5
   398→    fair_state := "غالي"
   399→else if fair_premium < -5
   400→    fair_state := "رخيص"
   401→else
   402→    fair_state := "عادل"
   403→
   404→float max_volume = ta.highest(volume, 100)
   405→var float poc_price = na
   406→if volume == max_volume
   407→    poc_price := close
   408→
   409→// ============================================================================ 
   410→// 12) DNA / PATTERN PROJECTION (CONNECTED LIQUIDITY CHAIN)
   411→// ============================================================================ 
   412→
   413→float dna_target1 = na
   414→float dna_move1 = na
   415→float dna_target2 = na
   416→float dna_move2 = na
   417→float dna_target3 = na
   418→float dna_move3 = na
   419→float dna_target_avg = na
   420→float dna_move_avg = na
   421→bool dna_bull_avg = false
   422→float dna_confidence = na
   423→
   424→float dna_fusion_target1 = na
   425→float dna_fusion_move1 = na
   426→float dna_fusion_target2 = na
   427→float dna_fusion_move2 = na
   428→float dna_fusion_target3 = na
   429→float dna_fusion_move3 = na
   430→
   431→int pattern_length = 8
   432→int search_depth = 100
   433→int projection_length = 10
   434→
   435→if barstate.islast
   436→
   437→    int available_bars = math.min(search_depth + projection_length + pattern_length + 10, bar_index + 1)
   438→    int start_i = projection_length + pattern_length - 1
   439→    int end_i = available_bars - pattern_length - 2
   440→
   441→    if end_i >= start_i
   442→
   443→        float dist1 = 1e10
   444→        int idx1 = 0
   445→        float dist2 = 1e10
   446→        int idx2 = 0
   447→        float dist3 = 1e10
   448→        int idx3 = 0
   449→        float total_dist = 0.0
   450→        int count_dist = 0
   451→
   452→        for i = start_i to end_i
   453→            float distance = 0.0
   454→            for j = 0 to pattern_length - 1
   455→                float current_c = close[j]
   456→                float current_prev = close[j + 1]
   457→                float current_return = current_prev != 0 ? (current_c - current_prev) / current_prev : 0
   458→
   459→                float hist_c = close[i + j]
   460→                float hist_prev = close[i + j + 1]
   461→                float hist_return = hist_prev != 0 ? (hist_c - hist_prev) / hist_prev : 0
   462→
   463→                float price_diff = current_return - hist_return
   464→
   465→                float current_vol = volume[j]
   466→                float current_vol_prev = volume[j + 1]
   467→                float current_vol_ret = current_vol_prev > 0 ? (current_vol - current_vol_prev) / current_vol_prev : 0
   468→
   469→                float hist_vol = volume[i + j]
   470→                float hist_vol_prev = volume[i + j + 1]
   471→                float hist_vol_ret = hist_vol_prev > 0 ? (hist_vol - hist_vol_prev) / hist_vol_prev : 0
   472→
   473→                float vol_diff = (current_vol_ret - hist_vol_ret) * 0.5
   474→                distance += (price_diff * price_diff) + (vol_diff * vol_diff)
   475→
   476→            total_dist += distance
   477→            count_dist += 1
   478→
   479→            if distance < dist1
   480→                dist3 := dist2
   481→                idx3 := idx2
   482→                dist2 := dist1
   483→                idx2 := idx1
   484→                dist1 := distance
   485→                idx1 := i
   486→            else if distance < dist2
   487→                dist3 := dist2
   488→                idx3 := idx2
   489→                dist2 := distance
   490→                idx2 := i
   491→            else if distance < dist3
   492→                dist3 := distance
   493→                idx3 := i
   494→
   495→        float avg_dist = count_dist > 0 ? total_dist / count_dist : 1e10
   496→        dna_confidence := avg_dist > 0 ? math.max(10, math.min(99, 100 * (1 - (dist1 / avg_dist)))) : 0
   497→
   498→        float hist_base1 = close[idx1]
   499→        float hist_future1 = close[idx1 - projection_length]
   500→        float ratio1 = hist_base1 > 0 ? hist_future1 / hist_base1 : 1
   501→
   502→        float hist_base2 = idx2 > 0 ? close[idx2] : hist_base1
   503→        float hist_future2 = idx2 > 0 ? close[idx2 - projection_length] : hist_future1
   504→        float ratio2 = hist_base2 > 0 ? hist_future2 / hist_base2 : 1
   505→
   506→        float hist_base3 = idx3 > 0 ? close[idx3] : hist_base1
   507→        float hist_future3 = idx3 > 0 ? close[idx3 - projection_length] : hist_future1
   508→        float ratio3 = hist_base3 > 0 ? hist_future3 / hist_base3 : 1
   509→
   510→        // CONNECTED DNA CHAIN
   511→        dna_target1 := close * ratio1
   512→        dna_move1 := close > 0 ? ((dna_target1 - close) / close) * 100 : 0
   513→
   514→        dna_target2 := dna_target1 * ratio2
   515→        dna_move2 := dna_target1 > 0 ? ((dna_target2 - dna_target1) / dna_target1) * 100 : 0
   516→
   517→        dna_target3 := dna_target2 * ratio3
   518→        dna_move3 := dna_target2 > 0 ? ((dna_target3 - dna_target2) / dna_target2) * 100 : 0
   519→
   520→        // LIQUIDITY FUSION
   521→        float fusion_liq_factor = math.max(-1.0, math.min(1.0, pressure_score * math.min(volume_ratio, 3.0) / 3.0 * 0.35))
   522→
   523→        dna_fusion_target1 := close * (ratio1 * (1.0 + fusion_liq_factor))
   524→        dna_fusion_target2 := dna_fusion_target1 * (ratio2 * (1.0 + fusion_liq_factor))
   525→        dna_fusion_target3 := dna_fusion_target2 * (ratio3 * (1.0 + fusion_liq_factor))
   526→
   527→        dna_fusion_move1 := close > 0 ? ((dna_fusion_target1 - close) / close) * 100 : 0
   528→        dna_fusion_move2 := dna_fusion_target1 > 0 ? ((dna_fusion_target2 - dna_fusion_target1) / dna_fusion_target1) * 100 : 0
   529→        dna_fusion_move3 := dna_fusion_target2 > 0 ? ((dna_fusion_target3 - dna_fusion_target2) / dna_fusion_target2) * 100 : 0
   530→
   531→        dna_target_avg := dna_fusion_target3
   532→        dna_move_avg := close > 0 ? ((dna_target_avg - close) / close) * 100 : 0
   533→        dna_bull_avg := dna_target_avg > close
   534→
   535→float dna_conf_safe = nz(dna_confidence, 0)
   536→bool dna_bull_safe = nz(dna_bull_avg, false)
   537→float dna_target_safe = nz(dna_target_avg, close)
   538→float dna_move_safe = nz(dna_move_avg, 0)
   539→
   540→float dna_fusion_move1_safe = nz(dna_fusion_move1, 0)
   541→float dna_fusion_move2_safe = nz(dna_fusion_move2, 0)
   542→float dna_fusion_move3_safe = nz(dna_fusion_move3, 0)
   543→
   544→// ============================================================================ 
   545→// 13) SCORE ENGINE
   546→// ============================================================================ 
   547→
   548→int trend_weight = 15
   549→int maker_weight = 15
   550→int rsi_weight = 10
   551→int volume_weight = 15
   552→int pivot_weight = 10
   553→int market_weight = 10
   554→int sector_weight = 10
   555→int dna_weight = 5
   556→int fair_weight = 5
   557→int liquidity_weight = 5
   558→int money_flow_weight = 10
   559→
   560→if trade_mode == "حذر"
   561→    trend_weight := 20
   562→    maker_weight := 10
   563→    volume_weight := 15
   564→    pivot_weight := 15
   565→    dna_weight := 3
   566→    money_flow_weight := 10
   567→else if trade_mode == "هجومي"
   568→    trend_weight := 10
   569→    maker_weight := 20
   570→    volume_weight := 20
   571→    pivot_weight := 5
   572→    dna_weight := 10
   573→    money_flow_weight := 10
   574→
   575→int score = 0
   576→score += trend_bull ? trend_weight : trend_bear ? -trend_weight : 0
   577→score += maker_bull ? maker_weight : maker_bear ? -maker_weight : 0
   578→score += rsi >= 50 and rsi < 70 ? rsi_weight : rsi < 40 ? -rsi_weight : 0
   579→score += volume_surge and close > open ? volume_weight : volume_surge and close < open ? -volume_weight : 0
   580→score += above_pivot ? pivot_weight : -pivot_weight
   581→score += outperform_market ? market_weight : -market_weight
   582→score += has_sector and sector_bull ? sector_weight : has_sector and sector_bear ? -sector_weight : 0
   583→score += dna_bull_safe and dna_conf_safe > 60 ? dna_weight : not dna_bull_safe and dna_conf_safe > 60 ? -dna_weight : 0
   584→score += fair_premium < 5 ? fair_weight : fair_premium > 10 ? -fair_weight : 0
   585→score += liquidity_state == "🟢 سيولة قوية داخلة" ? liquidity_weight : liquidity_state == "🔴 سيولة قوية خارجة" ? -liquidity_weight : 0
   586→score += strong_money_in ? money_flow_weight : strong_money_out ? -money_flow_weight : buy_volume_pct >= 55 ? 4 : sell_volume_pct >= 55 ? -4 : 0
   587→score := math.max(0, math.min(score + 50, 100))
   588→
   589→// ============================================================================ 
   590→// 14) FINAL SIGNAL
   591→// ============================================================================ 
   592→
   593→string signal = "انتظار"
   594→color signal_color = neutral_color
   595→
   596→if score >= 80 and trend_bull and above_pivot and strong_money_in
   597→    signal := "🟢 شراء قوي"
   598→    signal_color := bull_color
   599→else if score >= 65
   600→    signal := "🟢 إيجابي"
   601→    signal_color := bull_color
   602→else if score <= 25 and trend_bear and strong_money_out
   603→    signal := "🔴 تجنب"
   604→    signal_color := bear_color
   605→else if score <= 40
   606→    signal := "🔴 سلبي"
   607→    signal_color := bear_color
   608→else
   609→    signal := "🟡 انتظار"
   610→    signal_color := yellow_color
   611→
   612→float probability = math.max(5, math.min(95, 50 + (score - 50) * 0.85))
   613→
   614→// ============================================================================ 
   615→// 15) ANALYTICAL REASON ENGINE
   616→// ============================================================================ 
   617→
   618→string analysis_reason = ""
   619→
   620→if signal == "🟢 شراء قوي" or signal == "🟢 إيجابي"
   621→    analysis_reason := "📊 أسباب الصعود المتوقعة:\n"
   622→    if trend_bull
   623→        analysis_reason += "• ترند صاعد قوي (فوق المتوسطات).\n"
   624→    if above_pivot
   625→        analysis_reason += "• السعر فوق البيفوت اليومي.\n"
   626→    if maker_bull
   627→        analysis_reason += "• مؤشرات تجميع/امتصاص ميكرز.\n"
   628→    if volume_surge and close > open
   629→        analysis_reason += "• حجم تداول مرتفع مع شمعة إيجابية.\n"
   630→    if strong_money_in
   631→        analysis_reason += "• دخول سيولة تقديري قوي: " + str.tostring(estimated_buy_value_m, "#.##") + " مليون.\n"
   632→    else if buy_volume_pct >= 55
   633→        analysis_reason += "• ضغط الشراء التقديري " + str.tostring(buy_volume_pct, "#.#") + "%.\n"
   634→    if dna_bull_safe and dna_conf_safe > 60
   635→        analysis_reason += "• المسار المتصل (DNA) يتوقع " + str.tostring(dna_move_safe, "#.##") + "%.\n"
   636→    if has_sector and sector_bull
   637→        analysis_reason += "• قطاع السهم صاعد وداعم.\n"
   638→    if outperform_market
   639→        analysis_reason += "• السهم يتفوق على مؤشر EGX30.\n"
   640→else if signal == "🔴 تجنب" or signal == "🔴 سلبي"
   641→    analysis_reason := "📉 أسباب الهبوط/الضعف:\n"
   642→    if trend_bear
   643→        analysis_reason += "• ترند هابط (تحت المتوسطات).\n"
   644→    if not above_pivot
   645→        analysis_reason += "• السعر تحت البيفوت اليومي.\n"
   646→    if maker_bear
   647→        analysis_reason += "• مؤشرات تصريف ميكرز.\n"
   648→    if volume_surge and close < open
   649→        analysis_reason += "• حجم تداول مرتفع مع شمعة سلبية.\n"
   650→    if strong_money_out
   651→        analysis_reason += "• خروج سيولة تقديري قوي: " + str.tostring(estimated_sell_value_m, "#.##") + " مليون.\n"
   652→    else if sell_volume_pct >= 55
   653→        analysis_reason += "• ضغط البيع التقديري " + str.tostring(sell_volume_pct, "#.#") + "%.\n"
   654→    if not dna_bull_safe and dna_conf_safe > 60
   655→        analysis_reason += "• المسار المتصل (DNA) يتوقع هبوط " + str.tostring(dna_move_safe, "#.##") + "%.\n"
   656→    if has_sector and sector_bear
   657→        analysis_reason += "• قطاع السهم هابط وضاغط.\n"
   658→    if not outperform_market
   659→        analysis_reason += "• السهم أضعف من مؤشر EGX30.\n"
   660→else
   661→    analysis_reason := "⚖️ السهم في وضع عرضي/تذبذب.\n• لا توجد إشارة قوية متكاملة حالياً.\n• راقب الدعم والمقاومة والسيولة.\n"
   662→
   663→// ============================================================================ 
   664→// 16) STOP LOSS & TARGETS (معدل لأهداف واقعية)
   665→// ============================================================================ 
   666→
   667→float atr_pctrank = nz(ta.percentrank(atr, 100), 50)
   668→float atr_mult = atr_pctrank > 80 ? 2.0 : atr_pctrank < 20 ? 1.1 : 1.5
   669→
   670→float technical_stop = not na(last_support) and last_support < close ? last_support - atr * 0.25 : close - atr * atr_mult
   671→float stop_loss = technical_stop < close ? technical_stop : close - atr * atr_mult
   672→float risk_per_share = close - stop_loss
   673→
   674→// تم تقليل المضاعفات لتكون 1.0, 1.5, 2.0 بدلاً من 1.5, 2.5, 3.5
   675→float tp1 = close + risk_per_share * 1.0
   676→float tp2 = close + risk_per_share * 1.5
   677→float tp3 = close + risk_per_share * 2.0
   678→
   679→// نوازن الأهداف مع أقرب مقاومات حقيقية
   680→if not na(r1) and r1 > close
   681→    tp1 := math.min(tp1, r1)
   682→if not na(r2) and r2 > close
   683→    tp2 := math.min(tp2, r2)
   684→if not na(r3) and r3 > close
   685→    tp3 := math.min(tp3, r3)
   686→
   687→// ضمان عدم تطابق الأهداف أو تداخلها
   688→tp1 := math.max(tp1, close + risk_per_share * 0.5) // على الأقل نصف مخاطرة
   689→tp2 := math.max(tp2, tp1 + risk_per_share * 0.5)
   690→tp3 := math.max(tp3, tp2 + risk_per_share * 0.5)
   691→
   692→// --- جديد: حساب نسب الربح والخسارة ---
   693→float tp1_pct = close > 0 ? ((tp1 - close) / close) * 100 : 0
   694→float tp2_pct = close > 0 ? ((tp2 - close) / close) * 100 : 0
   695→float tp3_pct = close > 0 ? ((tp3 - close) / close) * 100 : 0
   696→float sl_pct = close > 0 ? ((close - stop_loss) / close) * 100 : 0
   697→
   698→// ============================================================================ 
   699→// 17) VISUALS & PLOTS (تم إخفاء الخطوط المزعجة لتنظيف الشارت)
   700→// ============================================================================ 
   701→
   702→// plot(show_levels ? pivot : na, title="Pivot", color=color.white, linewidth=2, style=plot.style_line)
   703→// plot(show_levels ? r1 : na, title="R1", color=color.new(bull_color, 20))
   704→// plot(show_levels ? s1 : na, title="S1", color=color.new(bear_color, 20))
   705→// plot(show_fair ? fair_value : na, title="Fair Value", color=purple_color, linewidth=2)
   706→// plot(show_poc ? poc_price : na, title="POC", color=orange_color, linewidth=2, style=plot.style_circles)
   707→
   708→// plot(show_vw_sr ? vw_res1 : na, title="Nearest Res 1", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
   709→// plot(show_vw_sr ? vw_res2 : na, title="Nearest Res 2", color=color.new(color.red, 30), style=plot.style_linebr, linewidth=1)
   710→// plot(show_vw_sr ? vw_res3 : na, title="Nearest Res 3", color=color.new(color.red, 60), style=plot.style_linebr, linewidth=1)
   711→
   712→// plot(show_vw_sr ? vw_sup1 : na, title="Nearest Sup 1", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
   713→// plot(show_vw_sr ? vw_sup2 : na, title="Nearest Sup 2", color=color.new(color.green, 30), style=plot.style_linebr, linewidth=1)
   714→// plot(show_vw_sr ? vw_sup3 : na, title="Nearest Sup 3", color=color.new(color.green, 60), style=plot.style_linebr, linewidth=1)
   715→
   716→// plot(ema20, title="EMA20", color=color.new(cyan_color, 25))
   717→// plot(ema50, title="EMA50", color=color.new(orange_color, 25))
   718→// plot(ema200, title="EMA200", color=color.new(purple_color, 25))
   719→
   720→plotshape(show_makers and absorption, title="Absorption", style=shape.triangleup, location=location.belowbar, color=bull_color, size=size.tiny, text="جمع")
   721→plotshape(show_makers and distribution, title="Distribution", style=shape.triangledown, location=location.abovebar, color=bear_color, size=size.tiny, text="تصريف")
   722→
   723→plotshape(show_money_flow and strong_money_in, title="Strong Money In", style=shape.circle, location=location.belowbar, color=bull_color, size=size.tiny, text="M+")
   724→plotshape(show_money_flow and strong_money_out, title="Strong Money Out", style=shape.circle, location=location.abovebar, color=bear_color, size=size.tiny, text="M-")
   725→
   726→// ============================================================================ 
   727→// 18) CONNECTED DNA VISUALS (3 LINES CHAIN)
   728→// ============================================================================ 
   729→
   730→var line dna_line1 = na
   731→var label dna_lbl1 = na
   732→var line dna_line2 = na
   733→var label dna_lbl2 = na
   734→var line dna_line3 = na
   735→var label dna_lbl3 = na
   736→
   737→if barstate.islast and show_dna and not na(dna_fusion_target1)
   738→    if not na(dna_line1)
   739→        line.delete(dna_line1)
   740→        label.delete(dna_lbl1)
   741→        line.delete(dna_line2)
   742→        label.delete(dna_lbl2)
   743→        line.delete(dna_line3)
   744→        label.delete(dna_lbl3)
   745→
   746→    // DNA 1: Current -> Target 1
   747→    dna_line1 := line.new(bar_index, close, bar_index + projection_length, dna_fusion_target1, xloc=xloc.bar_index, color=dna_fusion_move1_safe >= 0 ? bull_color : bear_color, width=3, style=line.style_solid)
   748→    dna_lbl1 := label.new(bar_index + projection_length, dna_fusion_target1, "DNA 1\n" + str.tostring(dna_fusion_move1_safe, "#.##") + "%", xloc=xloc.bar_index, color=dna_fusion_move1_safe >= 0 ? bull_color : bear_color, textcolor=color.white, style=label.style_label_left, size=size.tiny)
   749→
   750→    // DNA 2: Target 1 -> Target 2
   751→    dna_line2 := line.new(bar_index + projection_length, dna_fusion_target1, bar_index + projection_length * 2, dna_fusion_target2, xloc=xloc.bar_index, color=dna_fusion_move2_safe >= 0 ? bull_color : bear_color, width=2, style=line.style_dashed)
   752→    dna_lbl2 := label.new(bar_index + projection_length * 2, dna_fusion_target2, "DNA 2\n" + str.tostring(dna_fusion_move2_safe, "#.##") + "%", xloc=xloc.bar_index, color=dna_fusion_move2_safe >= 0 ? bull_color : bear_color, textcolor=color.white, style=label.style_label_left, size=size.tiny)
   753→
   754→    // DNA 3: Target 2 -> Target 3
   755→    dna_line3 := line.new(bar_index + projection_length * 2, dna_fusion_target2, bar_index + projection_length * 3, dna_fusion_target3, xloc=xloc.bar_index, color=dna_fusion_move3_safe >= 0 ? bull_color : bear_color, width=2, style=line.style_dotted)
   756→    dna_lbl3 := label.new(bar_index + projection_length * 3, dna_fusion_target3, "DNA 3\n" + str.tostring(dna_fusion_move3_safe, "#.##") + "%", xloc=xloc.bar_index, color=dna_fusion_move3_safe >= 0 ? bull_color : bear_color, textcolor=color.white, style=label.style_label_left, size=size.tiny)
   757→
   758→plotshape(show_dna and not na(dna_fusion_target1) and not dna_bull_safe and dna_conf_safe > 60, title="Bearish DNA Warning", style=shape.xcross, location=location.abovebar, color=color.red, size=size.small, text="DNA")
   759→
   760→// ============================================================================ 
   761→// 19) REASON LABEL
   762→// ============================================================================ 
   763→
   764→var label reason_label = na
   765→
   766→if barstate.islast and show_reason
   767→    if not na(reason_label)
   768→        label.delete(reason_label)
   769→    bool bullish_signal = signal == "🟢 شراء قوي" or signal == "🟢 إيجابي"
   770→    string short_reason = bullish_signal ? "📈 أسباب الصعود" : signal == "🔴 تجنب" or signal == "🔴 سلبي" ? "📉 أسباب الضعف" : "⚖️ وضع عرضي"
   771→    float reason_y = bullish_signal ? low - atr * 2 : high + atr * 2
   772→    reason_label := label.new(bar_index, reason_y, short_reason + "\n" + analysis_reason, color=color.new(signal_color, 10), textcolor=color.white, style=bullish_signal ? label.style_label_up : label.style_label_down, size=size.small)
   773→
   774→// ============================================================================ 
   775→// 20) DASHBOARD
   776→// ============================================================================ 
   777→
   778→var table dash = table.new(position.top_right, 5, 20, bgcolor=bg_main, frame_color=color.rgb(70, 85, 100), frame_width=1, border_color=color.rgb(50, 65, 80), border_width=1)
   779→
   780→f_cell(int col, int row, string txt, color txtColor, color cellBg) =>
   781→    table.cell(dash, col, row, txt, text_color=txtColor, bgcolor=cellBg, text_halign=text.align_center, text_valign=text.align_center, text_size=size.small)
   782→
   783→if barstate.islast
   784→    // HEADER
   785→    table.cell(dash, 0, 0, "🎯 V55 | " + syminfo.ticker, text_color=color.white, bgcolor=bg_header, text_halign=text.align_center, text_size=size.normal)
   786→    table.cell(dash, 1, 0, "SCORE", text_color=color.white, bgcolor=bg_header)
   787→    table.cell(dash, 2, 0, "الإشارة", text_color=color.white, bgcolor=bg_header)
   788→    table.cell(dash, 3, 0, "احتمال الصعود", text_color=color.white, bgcolor=bg_header)
   789→    table.cell(dash, 4, 0, "النمط", text_color=color.white, bgcolor=bg_header)
   790→
   791→    // MAIN DECISION
   792→    f_cell(0, 1, "القرار النهائي", neutral_color, bg_section)
   793→    f_cell(1, 1, str.tostring(score) + "%", score >= 65 ? bull_color : score <= 40 ? bear_color : yellow_color, bg_cell)
   794→    f_cell(2, 1, signal, signal_color, bg_cell)
   795→    f_cell(3, 1, str.tostring(probability, "#.#") + "%", probability >= 65 ? bull_color : probability <= 40 ? bear_color : yellow_color, bg_cell)
   796→    f_cell(4, 1, trade_mode, cyan_color, bg_cell)
   797→
   798→    // TREND / RSI
   799→    f_cell(0, 2, "الاتجاه", neutral_color, bg_section)
   800→    f_cell(1, 2, trend_bull ? "🟢 صاعد" : trend_bear ? "🔴 هابط" : "🟡 عرضي", trend_bull ? bull_color : trend_bear ? bear_color : yellow_color, bg_cell)
   801→    f_cell(2, 2, "RSI", neutral_color, bg_section)
   802→    f_cell(3, 2, str.tostring(rsi, "#.##"), rsi_color, bg_cell)
   803→    f_cell(4, 2, rsi_state, rsi_color, bg_cell)
   804→
   805→    // VOLUME / LIQUIDITY
   806→    f_cell(0, 3, "Volume", neutral_color, bg_section)
   807→    f_cell(1, 3, str.tostring(volume_ratio, "#.##") + "x", volume_ratio >= 1.3 ? bull_color : neutral_color, bg_cell)
   808→    f_cell(2, 3, "السيولة", neutral_color, bg_section)
   809→    f_cell(3, 3, liquidity_state, liquidity_state == "🟢 سيولة قوية داخلة" ? bull_color : liquidity_state == "🔴 سيولة قوية خارجة" ? bear_color : neutral_color, bg_cell)
   810→    f_cell(4, 3, maker_state, maker_bull ? bull_color : maker_bear ? bear_color : neutral_color, bg_cell)
   811→
   812→    // ESTIMATED BUY / SELL VOLUME
   813→    if show_money_flow
   814→        f_cell(0, 4, "🟢 شراء تقديري", neutral_color, bg_section)
   815→        f_cell(1, 4, str.tostring(estimated_buy_volume, "#") + " سهم", bull_color, bg_cell)
   816→        f_cell(2, 4, "🔴 بيع تقديري", neutral_color, bg_section)
   817→        f_cell(3, 4, str.tostring(estimated_sell_volume, "#") + " سهم", bear_color, bg_cell)
   818→        f_cell(4, 4, money_flow_state, money_flow_color, bg_cell)
   819→    else
   820→        f_cell(0, 4, "Money Flow", neutral_color, bg_section)
   821→        f_cell(1, 4, "OFF", neutral_color, bg_cell)
   822→        f_cell(2, 4, "", neutral_color, bg_cell)
   823→        f_cell(3, 4, "", neutral_color, bg_cell)
   824→        f_cell(4, 4, "", neutral_color, bg_cell)
   825→
   826→    // MONEY VALUE
   827→    if show_money_flow
   828→        f_cell(0, 5, "💰 قيمة شراء", neutral_color, bg_section)
   829→        f_cell(1, 5, str.tostring(estimated_buy_value_m, "#.##") + " M", bull_color, bg_cell)
   830→        f_cell(2, 5, "💰 قيمة بيع", neutral_color, bg_section)
   831→        f_cell(3, 5, str.tostring(estimated_sell_value_m, "#.##") + " M", bear_color, bg_cell)
   832→        f_cell(4, 5, "Net " + str.tostring(net_flow_m, "#.##") + " M", net_flow_m >= 0 ? bull_color : bear_color, bg_cell)
   833→    else
   834→        f_cell(0, 5, "Money Value", neutral_color, bg_section)
   835→        f_cell(1, 5, "OFF", neutral_color, bg_cell)
   836→        f_cell(2, 5, "", neutral_color, bg_cell)
   837→        f_cell(3, 5, "", neutral_color, bg_cell)
   838→        f_cell(4, 5, "", neutral_color, bg_cell)
   839→
   840→    // BUY / SELL PERCENTAGE
   841→    if show_money_flow
   842→        f_cell(0, 6, "شراء %", neutral_color, bg_section)
   843→        f_cell(1, 6, str.tostring(buy_volume_pct, "#.#") + "%", buy_volume_pct >= 55 ? bull_color : neutral_color, bg_cell)
   844→        f_cell(2, 6, "بيع %", neutral_color, bg_section)
   845→        f_cell(3, 6, str.tostring(sell_volume_pct, "#.#") + "%", sell_volume_pct >= 55 ? bear_color : neutral_color, bg_cell)
   846→        f_cell(4, 6, "B/S " + str.tostring(buy_sell_ratio, "#.##") + "x", buy_sell_ratio >= 1 ? bull_color : bear_color, bg_cell)
   847→    else
   848→        f_cell(0, 6, "Buy/Sell", neutral_color, bg_section)
   849→        f_cell(1, 6, "OFF", neutral_color, bg_cell)
   850→        f_cell(2, 6, "", neutral_color, bg_cell)
   851→        f_cell(3, 6, "", neutral_color, bg_cell)
   852→        f_cell(4, 6, "", neutral_color, bg_cell)
   853→
   854→    // SECTOR
   855→    f_cell(0, 7, "القطاع", neutral_color, bg_section)
   856→    f_cell(1, 7, sector_name, cyan_color, bg_cell)
   857→    f_cell(2, 7, "حالة القطاع", neutral_color, bg_section)
   858→    f_cell(3, 7, sector_state, sector_money_in ? bull_color : sector_money_out ? bear_color : yellow_color, bg_cell)
   859→    f_cell(4, 7, has_sector ? str.tostring(stock_vs_sector, "#.##") + "%" : "N/A", has_sector ? (stock_vs_sector >= 0 ? bull_color : bear_color) : neutral_color, bg_cell)
   860→
   861→    // PIVOT & FAIR
   862→    f_cell(0, 8, "Pivot", neutral_color, bg_section)
   863→    f_cell(1, 8, str.tostring(pivot, format.mintick), above_pivot ? bull_color : bear_color, bg_cell)
   864→    f_cell(2, 8, "حالة Pivot", neutral_color, bg_section)
   865→    f_cell(3, 8, pivot_state, above_pivot ? bull_color : bear_color, bg_cell)
   866→    f_cell(4, 8, "Fair " + str.tostring(fair_premium, "#.##") + "%", fair_premium <= 5 ? bull_color : bear_color, bg_cell)
   867→
   868→    // SUPPORTS
   869→    f_cell(0, 9, "الدعوم", neutral_color, bg_section)
   870→    f_cell(1, 9, "S1 " + str.tostring(s1, format.mintick), close > s1 ? bull_color : bear_color, bg_cell)
   871→    f_cell(2, 9, "S2 " + str.tostring(s2, format.mintick), close > s2 ? bull_color : bear_color, bg_cell)
   872→    f_cell(3, 9, "S3 " + str.tostring(s3, format.mintick), close > s3 ? bull_color : bear_color, bg_cell)
   873→    f_cell(4, 9, not na(last_support) ? "Swing " + str.tostring(last_support, format.mintick) : "N/A", bull_color, bg_cell)
   874→
   875→    // RESISTANCES
   876→    f_cell(0, 10, "المقاومات", neutral_color, bg_section)
   877→    f_cell(1, 10, "R1 " + str.tostring(r1, format.mintick), r1 > close ? yellow_color : bull_color, bg_cell)
   878→    f_cell(2, 10, "R2 " + str.tostring(r2, format.mintick), r2 > close ? yellow_color : bull_color, bg_cell)
   879→    f_cell(3, 10, "R3 " + str.tostring(r3, format.mintick), r3 > close ? yellow_color : bull_color, bg_cell)
   880→    f_cell(4, 10, not na(last_resistance) ? "Swing " + str.tostring(last_resistance, format.mintick) : "N/A", orange_color, bg_cell)
   881→
   882→    // TARGETS WITH PERCENTAGES (تمت إضافة نسبة الربح)
   883→    f_cell(0, 11, "🎯 TP1", white_color, bg_section)
   884→    f_cell(1, 11, str.tostring(tp1, format.mintick) + " (+" + str.tostring(tp1_pct, "#.##") + "%)", bull_color, bg_cell)
   885→    f_cell(2, 11, "TP2", white_color, bg_section)
   886→    f_cell(3, 11, str.tostring(tp2, format.mintick) + " (+" + str.tostring(tp2_pct, "#.##") + "%)", bull_color, bg_cell)
   887→    f_cell(4, 11, "TP3 " + str.tostring(tp3, format.mintick) + " (+" + str.tostring(tp3_pct, "#.##") + "%)", bull_color, bg_cell)
   888→
   889→    // RISK WITH PERCENTAGE (تمت إضافة نسبة الخسارة)
   890→    f_cell(0, 12, "وقف الخسارة", neutral_color, bg_section)
   891→    f_cell(1, 12, str.tostring(stop_loss, format.mintick) + " (-" + str.tostring(sl_pct, "#.##") + "%)", bear_color, bg_cell)
   892→    f_cell(2, 12, "Risk", neutral_color, bg_section)
   893→    f_cell(3, 12, str.tostring(risk_per_share, format.mintick), orange_color, bg_cell)
   894→    f_cell(4, 12, "RR 1:" + str.tostring(risk_per_share > 0 ? (tp1 - close) / risk_per_share : 0, "#.##"), cyan_color, bg_cell)
   895→
   896→    // CONNECTED DNA CHAIN
   897→    f_cell(0, 13, "🧬 DNA 1 + LIQ", neutral_color, bg_section)
   898→    f_cell(1, 13, str.tostring(dna_fusion_move1_safe, "#.##") + "%", dna_fusion_move1_safe >= 0 ? bull_color : bear_color, bg_cell)
   899→    f_cell(2, 13, "DNA 2 + LIQ", neutral_color, bg_section)
   900→    f_cell(3, 13, str.tostring(dna_fusion_move2_safe, "#.##") + "%", dna_fusion_move2_safe >= 0 ? bull_color : bear_color, bg_cell)
   901→    f_cell(4, 13, "DNA 3 + LIQ " + str.tostring(dna_fusion_move3_safe, "#.##") + "%", dna_fusion_move3_safe >= 0 ? bull_color : bear_color, bg_cell)
   902→
   903→    // DNA AGGREGATE
   904→    f_cell(0, 14, "🧬 المسار الكلي", neutral_color, bg_section)
   905→    f_cell(1, 14, str.tostring(dna_move_safe, "#.##") + "%", dna_bull_safe ? bull_color : bear_color, bg_cell)
   906→    f_cell(2, 14, "الهدف النهائي", neutral_color, bg_section)
   907→    f_cell(3, 14, str.tostring(dna_target_safe, format.mintick), cyan_color, bg_cell)
   908→    f_cell(4, 14, "ثقة " + str.tostring(dna_conf_safe, "#") + "%", dna_conf_safe > 70 ? bull_color : dna_conf_safe > 40 ? yellow_color : bear_color, bg_cell)
   909→
   910→    // VOLUME-WEIGHTED RESISTANCE
   911→    f_cell(0, 16, "🚧 مقاومات حجمية", neutral_color, bg_section)
   912→    f_cell(1, 16, "أقرب مقاومة (1)", neutral_color, bg_cell)
   913→    f_cell(2, 16, not na(vw_res1) ? str.tostring(vw_res1, format.mintick) : "تم اختراق الكل", yellow_color, bg_cell)
   914→    f_cell(3, 16, "المقاومة (2)", neutral_color, bg_cell)
   915→    f_cell(4, 16, not na(vw_res2) ? str.tostring(vw_res2, format.mintick) : "تم اختراق الكل", bear_color, bg_cell)
   916→
   917→    f_cell(0, 17, "المقاومة (3)", neutral_color, bg_section)
   918→    f_cell(1, 17, not na(vw_res3) ? str.tostring(vw_res3, format.mintick) : "تم اختراق الكل", orange_color, bg_cell)
   919→    f_cell(2, 17, "Swing Res", neutral_color, bg_cell)
   920→    f_cell(3, 17, not na(last_resistance) ? str.tostring(last_resistance, format.mintick) : "N/A", orange_color, bg_cell)
   921→    f_cell(4, 17, "", neutral_color, bg_cell)
   922→
   923→    // VOLUME-WEIGHTED SUPPORT
   924→    f_cell(0, 18, "🛡️ دعوم حجمية", neutral_color, bg_section)
   925→    f_cell(1, 18, "أقرب دعم (1)", neutral_color, bg_cell)
   926→    f_cell(2, 18, not na(vw_sup1) ? str.tostring(vw_sup1, format.mintick) : "تم كسر الكل", yellow_color, bg_cell)
   927→    f_cell(3, 18, "الدعم (2)", neutral_color, bg_cell)
   928→    f_cell(4, 18, not na(vw_sup2) ? str.tostring(vw_sup2, format.mintick) : "تم كسر الكل", bull_color, bg_cell)
   929→
   930→    f_cell(0, 19, "الدعم (3)", neutral_color, bg_section)
   931→    f_cell(1, 19, not na(vw_sup3) ? str.tostring(vw_sup3, format.mintick) : "تم كسر الكل", cyan_color, bg_cell)
   932→    f_cell(2, 19, "Swing Sup", neutral_color, bg_cell)
   933→    f_cell(3, 19, not na(last_support) ? str.tostring(last_support, format.mintick) : "N/A", bull_color, bg_cell)
   934→    f_cell(4, 19, "", neutral_color, bg_cell)
   935→
   936→    // ANALYTICAL REASON
   937→    string dashboard_reason = "📝 " + (show_money_flow ? "Flow: " + money_flow_state + " | Net: " + str.tostring(net_flow_m, "#.##") + "M\n" : "") + analysis_reason
   938→    table.merge_cells(dash, 0, 15, 4, 15)
   939→    f_cell(0, 15, dashboard_reason, signal_color, bg_cell)
   940→
   941→// ============================================================================ 
   942→// 21) ALERTS
   943→// ============================================================================ 
   944→
   945→alertcondition(signal == "🟢 شراء قوي", title="شراء قوي", message="V55: إشارة شراء قوية على {{ticker}}")
   946→alertcondition(signal == "🔴 تجنب", title="تجنب", message="V55: السهم سلبي {{ticker}}")
   947→alertcondition(strong_money_in, title="دخول سيولة قوي", message="V55: دخول سيولة قوي تقديرياً على {{ticker}}")
   948→alertcondition(strong_money_out, title="خروج سيولة قوي", message="V55: خروج سيولة قوي تقديرياً على {{ticker}}")
   949→alertcondition(not na(dna_fusion_target1) and not dna_bull_safe and dna_conf_safe > 60, title="تحذير DNA هابط", message="V55: تحذير DNA هابط على {{ticker}}")
   950→alertcondition(money_in and not money_out, title="ضغط شراء", message="V55: ضغط الشراء أعلى من البيع على {{ticker}}")
   951→alertcondition(money_out and not money_in, title="ضغط بيع", message="V55: ضغط البيع أعلى من الشراء على {{ticker}}")