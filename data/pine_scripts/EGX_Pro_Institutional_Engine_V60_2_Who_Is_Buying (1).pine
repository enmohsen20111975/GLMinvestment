//@version=6
indicator("محرك القرار المؤسسي V60.2 - EGX PRO Institutional Engine", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============================================================================ 
// 1) SETTINGS
// ============================================================================ 

group_market = "🇪🇬 السوق"
market_type = input.string("EGX", "السوق", options=["EGX", "Global"], group=group_market)
benchmark_ticker = input.symbol("EGX:EGX30", "مؤشر السوق", group=group_market)
sector_benchmark = input.symbol("", "مؤشر القطاع - اختياري", group=group_market)

group_mode = "🧠 المحرك الذكي"
trade_mode = input.string("متوازن", "نمط التداول", options=["حذر", "متوازن", "هجومي"], group=group_mode)

group_visual = "🎨 الشكل"
show_levels = input.bool(true, "إظهار الدعوم/المقاومات الديناميكية", group=group_visual)
show_smc = input.bool(true, "إظهار مناطق SMC (OB & FVG)", group=group_visual)
show_makers = input.bool(true, "إظهار إشارات الميكرز", group=group_visual)
show_dna = input.bool(true, "إظهار البصمة المتصلة (3 DNA)", group=group_visual)
show_reason = input.bool(true, "إظهار التعليق التحليلي", group=group_visual)

group_flow = "💰 Money Flow"
show_money_flow = input.bool(true, "إظهار تحليل الشراء والبيع", group=group_flow)
flow_strong_threshold = input.float(60.0, "نسبة السيولة القوية %", minval=50, maxval=90, step=1, group=group_flow)
flow_volume_threshold = input.float(1.20, "مضاعف الحجم لتأكيد السيولة", minval=1.0, maxval=5.0, step=0.05, group=group_flow)
flow_lookback = input.int(20, "فترة تأكيد Money Flow", minval=5, maxval=100, group=group_flow)
group_who = "👥 WHO IS BUYING? - مؤسسات vs أفراد"
show_who_buying = input.bool(true, "إظهار تحليل مؤسسات/أفراد", group=group_who)
who_lookback = input.int(20, "فترة ثبات التدفق", minval=5, maxval=60, group=group_who)
who_inst_threshold = input.int(65, "حد المؤسسات", minval=50, maxval=90, group=group_who)
who_retail_threshold = input.int(65, "حد الأفراد", minval=50, maxval=90, group=group_who)
who_volume_threshold = input.float(1.50, "حجم غير طبيعي للمؤسسات", minval=1.10, maxval=5.0, step=0.05, group=group_who)
who_mfi_length = input.int(14, "MFI", minval=2, maxval=50, group=group_who)


group_fake = "🚨 كشف الصعود الوهمي"
fake_rise_lookback = input.int(5, "فترة قياس الصعود السريع", minval=2, maxval=20, group=group_fake)
fake_rise_threshold = input.float(7.0, "حد الصعود السريع %", minval=3.0, maxval=20.0, step=0.5, group=group_fake)
fake_risk_threshold = input.int(55, "حد خطر الصعود الوهمي", minval=40, maxval=80, group=group_fake)

group_risk = "💼 إدارة المخاطر ورأس المال"
account_balance = input.float(10000, "رأس المال (سيولة الحساب)", minval=0, group=group_risk)
risk_percent = input.float(1.0, "المخاطرة الأساسية % (لكل صفقة)", minval=0.1, maxval=5, step=0.1, group=group_risk)

group_calc = "⚙️ الحسابات"
rsi_length = input.int(14, "RSI", minval=2, group=group_calc)
atr_length = input.int(14, "ATR", minval=2, group=group_calc)
pivot_length = input.int(5, "Pivot Length", minval=2, maxval=20, group=group_calc)

// ============================================================================ 
// 2) COLORS
// ============================================================================ 

color bg_main = color.rgb(12, 18, 28)
color bg_header = color.rgb(0, 75, 105)
color bg_section = color.rgb(25, 35, 50)
color bg_cell = color.rgb(18, 27, 39)

color bull_color = color.rgb(0, 210, 110)
color bear_color = color.rgb(245, 65, 75)
color neutral_color = color.rgb(170, 175, 185)
color yellow_color = color.rgb(255, 190, 50)
color orange_color = color.rgb(255, 135, 35)
color cyan_color = color.rgb(0, 200, 220)
color purple_color = color.rgb(175, 90, 240)
color white_color = color.white

// ============================================================================ 
// 3) BASIC DATA & MOMENTUM
// ============================================================================ 

float atr = ta.atr(atr_length)
float rsi = ta.rsi(close, rsi_length)

float ema10 = ta.ema(close, 10)
float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)

[macd_line, macd_signal, macd_hist] = ta.macd(close, 12, 26, 9)
bool macd_bull = macd_line > macd_signal and macd_hist > 0
bool macd_bear = macd_line < macd_signal and macd_hist < 0

bool ma_bull_align = close > ema10 and ema10 > ema20 and ema20 > ema50 and ema50 > ema200
bool ma_bear_align = close < ema10 and ema10 < ema20 and ema20 < ema50 and ema50 < ema200

float vol_ma = ta.sma(volume, 20)
float vol_std = ta.stdev(volume, 20)
float volume_ratio = vol_ma > 0 ? volume / vol_ma : 0
bool volume_strong = volume_ratio >= 1.30
bool volume_extreme = volume_ratio >= 2.00
float stock_roc_14 = ta.roc(close, 14)
bool trend_bull = close > ema20 and ema20 > ema50 and ema50 > ema200
bool trend_bear = close < ema20 and ema20 < ema50 and ema50 < ema200

// ============================================================================ 
// 4) ICHIMOKU CLOUD
// ============================================================================ 

int conv_len = 9
int base_len = 26
int span_b_len = 52
int displacement = 26

float tenkan = math.avg(ta.highest(high, conv_len), ta.lowest(low, conv_len))
float kijun = math.avg(ta.highest(high, base_len), ta.lowest(low, base_len))
float senkouA = math.avg(tenkan, kijun)
float senkouB = math.avg(ta.highest(high, span_b_len), ta.lowest(low, span_b_len))
float current_cloudA = senkouA[displacement - 1]
float current_cloudB = senkouB[displacement - 1]

bool ichimoku_bull = not na(current_cloudA) and not na(current_cloudB) and close > current_cloudA and close > current_cloudB
bool ichimoku_bear = not na(current_cloudA) and not na(current_cloudB) and close < current_cloudA and close < current_cloudB
string ichimoku_state = ichimoku_bull ? "🟢 فوق السحابة" : ichimoku_bear ? "🔴 تحت السحابة" : "🟡 داخل السحابة"
color ichimoku_color = ichimoku_bull ? bull_color : ichimoku_bear ? bear_color : yellow_color
bool ichimoku_strong_bull = ichimoku_bull and current_cloudA > current_cloudB and tenkan > kijun
bool ichimoku_strong_bear = ichimoku_bear and current_cloudA < current_cloudB and tenkan < kijun

// ============================================================================ 
// 5) MARKET & PIVOT BENCHMARK
// ============================================================================ 

[market_close, market_roc] = request.security(benchmark_ticker, timeframe.period, [close, ta.roc(close, 14)], barmerge.gaps_off, barmerge.lookahead_off)
float relative_market_strength = stock_roc_14 - nz(market_roc)
bool outperform_market = relative_market_strength > 0

[prev_day_high, prev_day_low, prev_day_close] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_off)
float pivot = (prev_day_high + prev_day_low + prev_day_close) / 3.0

float r1 = 2.0 * pivot - prev_day_low
float r2 = pivot + (prev_day_high - prev_day_low)
float r3 = prev_day_high + 2.0 * (pivot - prev_day_low)
float s1 = 2.0 * pivot - prev_day_high
float s2 = pivot - (prev_day_high - prev_day_low)
float s3 = prev_day_low - 2.0 * (prev_day_high - pivot)

bool above_pivot = close > pivot
string pivot_state = above_pivot ? "🟢 إيجابي" : "🔴 سلبي"

// ============================================================================ 
// 6) SECTOR / INDUSTRY
// ============================================================================ 

string auto_sector = syminfo.sector
string sector_name = na(auto_sector) or auto_sector == "" ? "غير محدد" : auto_sector
bool has_sector = sector_benchmark != ""
string sec_sym = has_sector ? sector_benchmark : syminfo.tickerid

[sec_close, sec_vol, sec_vol_ma] = request.security(sec_sym, timeframe.period, [close, volume, ta.sma(volume, 20)], barmerge.gaps_off, barmerge.lookahead_off)

float sector_close = has_sector ? sec_close : na
float sector_roc = has_sector ? ta.roc(sector_close, 14) : na
float stock_vs_sector = has_sector ? stock_roc_14 - nz(sector_roc) : na
float sector_ema20 = has_sector ? ta.ema(sector_close, 20) : na

bool sector_bull = has_sector and sector_roc > 0 and sector_close > sector_ema20
bool sector_bear = has_sector and sector_roc < 0 and sector_close < sector_ema20
float sector_volume_ratio = has_sector and sec_vol_ma > 0 ? sec_vol / sec_vol_ma : na
bool sector_money_in = has_sector and sector_volume_ratio >= 1.20 and sector_roc > 0
bool sector_money_out = has_sector and sector_volume_ratio >= 1.20 and sector_roc < 0

string sector_state = "⚪ غير متاح"
if has_sector
    sector_state := sector_money_in ? "🟢 سيولة داخلة" : sector_money_out ? "🔴 سيولة خارجة" : sector_bull ? "🟢 صاعد" : sector_bear ? "🔴 هابط" : "🟡 عرضي"

// ============================================================================ 
// 7) RSI STATE & BOLLINGER
// ============================================================================ 

string rsi_state = "محايد"
color rsi_color = neutral_color
if rsi >= 70
    rsi_state := "تشبع شراء"
    rsi_color := orange_color
else if rsi >= 55
    rsi_state := "إيجابي"
    rsi_color := bull_color
else if rsi <= 30
    rsi_state := "تشبع بيع"
    rsi_color := purple_color
else if rsi < 45
    rsi_state := "سلبي"
    rsi_color := bear_color

[bb_mid, bb_up, bb_low] = ta.bb(close, 20, 2.0)
float bb_width = bb_mid != 0 ? ((bb_up - bb_low) / bb_mid) * 100 : 0
float bb_width_avg = ta.sma(bb_width, 50)
float bb_width_std = ta.stdev(bb_width, 50)
bool squeeze = bb_width < bb_width_avg - nz(bb_width_std)
bool expansion = bb_width > bb_width_avg + nz(bb_width_std)
string volatility_state = expansion ? "⚡ انفراج" : squeeze ? "😴 ضغط" : "طبيعي"

// ============================================================================ 
// 8) DYNAMIC ROLE REVERSAL SUPPORT / RESISTANCE ENGINE
// ============================================================================

float swing_high = ta.pivothigh(high, pivot_length, pivot_length)
float swing_low = ta.pivotlow(low, pivot_length, pivot_length)

var float last_resistance = na
var float last_support = na

if not na(swing_high)
    last_resistance := swing_high
if not na(swing_low)
    last_support := swing_low

var float[] rr_supports = array.new_float()
var float[] rr_resistances = array.new_float()

rr_add_unique(float[] levels, float level) =>
    bool exists = false
    if not na(level)
        if array.size(levels) > 0
            for j = 0 to array.size(levels) - 1
                if math.abs(array.get(levels, j) - level) / level <= 0.002
                    exists := true
        if not exists
            array.push(levels, level)
            if array.size(levels) > 30
                array.shift(levels)

if not na(swing_high)
    if swing_high > close
        rr_add_unique(rr_resistances, swing_high)
    else
        rr_add_unique(rr_supports, swing_high)

if not na(swing_low)
    if swing_low < close
        rr_add_unique(rr_supports, swing_low)
    else
        rr_add_unique(rr_resistances, swing_low)

if array.size(rr_resistances) > 0
    for i = array.size(rr_resistances) - 1 to 0
        float level = array.get(rr_resistances, i)
        if close > level
            array.remove(rr_resistances, i)
            rr_add_unique(rr_supports, level)

if array.size(rr_supports) > 0
    for i = array.size(rr_supports) - 1 to 0
        float level = array.get(rr_supports, i)
        if close < level
            array.remove(rr_supports, i)
            rr_add_unique(rr_resistances, level)

float rr_sup1 = na, float rr_sup2 = na, float rr_sup3 = na
float rr_res1 = na, float rr_res2 = na, float rr_res3 = na

if array.size(rr_supports) > 0
    float min_dist = 1e10, float next_dist = 1e10, float third_dist = 1e10
    for i = 0 to array.size(rr_supports) - 1
        float p = array.get(rr_supports, i)
        if p < close
            float dist = close - p
            if dist < min_dist
                third_dist := next_dist
                rr_sup3 := rr_sup2
                next_dist := min_dist
                rr_sup2 := rr_sup1
                min_dist := dist
                rr_sup1 := p
            else if dist < next_dist
                third_dist := next_dist
                rr_sup3 := rr_sup2
                next_dist := dist
                rr_sup2 := p
            else if dist < third_dist
                third_dist := dist
                rr_sup3 := p

if array.size(rr_resistances) > 0
    float min_dist_r = 1e10, float next_dist_r = 1e10, float third_dist_r = 1e10
    for i = 0 to array.size(rr_resistances) - 1
        float p = array.get(rr_resistances, i)
        if p > close
            float dist = p - close
            if dist < min_dist_r
                third_dist_r := next_dist_r
                rr_res3 := rr_res2
                next_dist_r := min_dist_r
                rr_res2 := rr_res1
                min_dist_r := dist
                rr_res1 := p
            else if dist < next_dist_r
                third_dist_r := next_dist_r
                rr_res3 := rr_res2
                next_dist_r := dist
                rr_res2 := p
            else if dist < third_dist_r
                third_dist_r := dist
                rr_res3 := p

float nearest_res = rr_res1
float nearest_sup = rr_sup1

plot(show_levels ? rr_sup1 : na, "Dynamic Sup 1", color=color.new(bull_color, 0), linewidth=2, style=plot.style_linebr)
plot(show_levels ? rr_sup2 : na, "Dynamic Sup 2", color=color.new(bull_color, 30), linewidth=1, style=plot.style_linebr)
plot(show_levels ? rr_res1 : na, "Dynamic Res 1", color=color.new(bear_color, 0), linewidth=2, style=plot.style_linebr)
plot(show_levels ? rr_res2 : na, "Dynamic Res 2", color=color.new(bear_color, 30), linewidth=1, style=plot.style_linebr)

// ============================================================================ 
// 9) VOLUME / LIQUIDITY & MONEY FLOW
// ============================================================================ 

float dynamic_volume_level = vol_ma + nz(vol_std) * 1.5
bool volume_surge = volume > dynamic_volume_level

string liquidity_state = "⚪ عادية"
if volume_extreme and close > open
    liquidity_state := "🟢 سيولة قوية داخلة"
else if volume_extreme and close < open
    liquidity_state := "🔴 سيولة قوية خارجة"
else if volume_surge and close > open
    liquidity_state := "🟢 دخول سيولة"
else if volume_surge and close < open
    liquidity_state := "🔴 خروج سيولة"
else if volume > vol_ma
    liquidity_state := "🟡 مرتفعة"

float flow_range = math.max(high - low, syminfo.mintick)
float clv = ((close - low) - (high - close)) / flow_range
clv := math.max(-1.0, math.min(1.0, clv))
float body_pressure = (close - open) / flow_range
body_pressure := math.max(-1.0, math.min(1.0, body_pressure))

float pressure_score = clv * 0.65 + body_pressure * 0.35
pressure_score := math.max(-1.0, math.min(1.0, pressure_score))

float estimated_buy_volume = volume * (0.5 + pressure_score * 0.5)
float estimated_sell_volume = volume - estimated_buy_volume
float buy_volume_pct = volume > 0 ? estimated_buy_volume / volume * 100 : 50
float sell_volume_pct = volume > 0 ? estimated_sell_volume / volume * 100 : 50

float estimated_buy_value_m = estimated_buy_volume * close / 1000000
float estimated_sell_value_m = estimated_sell_volume * close / 1000000
float net_flow_m = estimated_buy_value_m - estimated_sell_value_m

float cmf_mfv = ((high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0) * volume
float cmf = ta.sma(cmf_mfv, flow_lookback) / math.max(ta.sma(volume, flow_lookback), 1)
float obv = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
float obv_ema = ta.ema(obv, flow_lookback)

bool flow_confirm_bull = cmf > 0 and obv > obv_ema
bool flow_confirm_bear = cmf < 0 and obv < obv_ema

bool strong_money_in = buy_volume_pct >= flow_strong_threshold and net_flow_m > 0 and flow_confirm_bull and volume_ratio >= flow_volume_threshold
bool strong_money_out = sell_volume_pct >= flow_strong_threshold and net_flow_m < 0 and flow_confirm_bear and volume_ratio >= flow_volume_threshold

string money_flow_state = "⚪ متوازنة"
color money_flow_color = neutral_color
if strong_money_in
    money_flow_state := "🔥 دخول سيولة قوي مؤكد"
    money_flow_color := bull_color
else if strong_money_out
    money_flow_state := "🔥 خروج سيولة قوي مؤكد"
    money_flow_color := bear_color
else if buy_volume_pct >= 55 and net_flow_m > 0
    money_flow_state := "🟢 سيولة داخلة"
    money_flow_color := bull_color
else if sell_volume_pct >= 55 and net_flow_m < 0
    money_flow_state := "🔴 سيولة خارجة"
    money_flow_color := bear_color

// ============================================================================ 
// 10) SMART MONEY FOOTPRINTS & WYCKOFF ENGINE
// ============================================================================ 

float candle_range = high - low
float upper_wick = high - math.max(open, close)
float lower_wick = math.min(open, close) - low

bool large_order_bull = volume_ratio >= 2.0 and close > open and (close - low) / math.max(candle_range, syminfo.mintick) > 0.75
bool large_order_bear = volume_ratio >= 2.0 and close < open and (high - close) / math.max(candle_range, syminfo.mintick) > 0.75

bool smart_buy = large_order_bull and flow_confirm_bull
bool smart_sell = large_order_bear and flow_confirm_bear

bool absorption = candle_range > 0 and close < open and lower_wick > candle_range * 0.50 and volume_surge
bool distribution = candle_range > 0 and close > open and upper_wick > candle_range * 0.50 and volume_surge

bool maker_bull = absorption or smart_buy or (not na(last_support) and low < last_support and close > last_support)
bool maker_bear = distribution or smart_sell or (not na(last_resistance) and high > last_resistance and close < last_resistance)
string maker_state = maker_bull ? "🟢 تجميع/شراء" : maker_bear ? "🔴 تصريف/بيع" : "⚪ محايد"

// Wyckoff Engine
float range_ma = ta.sma(high - low, 20)
bool is_narrow_range = (high - low) < range_ma
bool vol_drying = vol_ma < vol_ma[5]
bool rsi_div_bull = low < low[5] and rsi > rsi[5]
bool rsi_div_bear = high > high[5] and rsi < rsi[5]

bool accumulation_phase = is_narrow_range and vol_drying and rsi_div_bull and not trend_bear
bool distribution_phase = is_narrow_range and vol_drying and rsi_div_bear and not trend_bull

string wyckoff_phase = "⚪ لا يوجد نمط واضح"
color wyckoff_color = neutral_color
if accumulation_phase
    wyckoff_phase := "🟢 تجميع (Accumulation)"
    wyckoff_color := bull_color
else if distribution_phase
    wyckoff_phase := "🔴 تصريف (Distribution)"
    wyckoff_color := bear_color

// ============================================================================ 
// 11) FAIR VALUE / POC
// ============================================================================ 

float total_volume = math.sum(volume, 100)
float weighted_price = math.sum(hlc3 * volume, 100)
float fair_value = total_volume > 0 ? weighted_price / total_volume : close
float fair_premium = fair_value > 0 ? ((close - fair_value) / fair_value) * 100 : 0

string fair_state = "عادل"
if fair_premium > 5
    fair_state := "غالي"
else if fair_premium < -5
    fair_state := "رخيص"

float max_volume = ta.highest(volume, 100)
var float poc_price = na
if volume == max_volume
    poc_price := hlc3

// ============================================================================ 
// 12) DNA / PATTERN PROJECTION
// ============================================================================ 

float dna_target1 = na
float dna_move1 = na
float dna_target2 = na
float dna_move2 = na
float dna_target3 = na
float dna_move3 = na
float dna_target_avg = na
float dna_move_avg = na
bool dna_bull_avg = false
float dna_confidence = na

float dna_fusion_target1 = na
float dna_fusion_move1 = na
float dna_fusion_target2 = na
float dna_fusion_move2 = na
float dna_fusion_target3 = na
float dna_fusion_move3 = na

int pattern_length = 8
int search_depth = 100
int projection_length = 10

if barstate.islast
    int available_bars = math.min(search_depth + projection_length + pattern_length + 10, bar_index + 1)
    int start_i = projection_length + pattern_length - 1
    int end_i = available_bars - pattern_length - 2

    if end_i >= start_i
        float dist1 = 1e10
        int idx1 = 0
        float dist2 = 1e10
        int idx2 = 0
        float dist3 = 1e10
        int idx3 = 0
        float total_dist = 0.0
        int count_dist = 0

        for i = start_i to end_i
            float distance = 0.0
            for j = 0 to pattern_length - 1
                float current_c = close[j]
                float current_prev = close[j + 1]
                float current_return = current_prev != 0 ? (current_c - current_prev) / current_prev : 0

                float hist_c = close[i + j]
                float hist_prev = close[i + j + 1]
                float hist_return = hist_prev != 0 ? (hist_c - hist_prev) / hist_prev : 0

                float price_diff = current_return - hist_return

                float current_vol = volume[j]
                float current_vol_prev = volume[j + 1]
                float current_vol_ret = current_vol_prev > 0 ? (current_vol - current_vol_prev) / current_vol_prev : 0

                float hist_vol = volume[i + j]
                float hist_vol_prev = volume[i + j + 1]
                float hist_vol_ret = hist_vol_prev > 0 ? (hist_vol - hist_vol_prev) / hist_vol_prev : 0

                float vol_diff = (current_vol_ret - hist_vol_ret) * 0.5
                distance += (price_diff * price_diff) + (vol_diff * vol_diff)

            total_dist += distance
            count_dist += 1

            if distance < dist1
                dist3 := dist2
                idx3 := idx2
                dist2 := dist1
                idx2 := idx1
                dist1 := distance
                idx1 := i
            else if distance < dist2
                dist3 := dist2
                idx3 := idx2
                dist2 := distance
                idx2 := i
            else if distance < dist3
                dist3 := distance
                idx3 := i

        float avg_dist = count_dist > 0 ? total_dist / count_dist : 1e10
        dna_confidence := avg_dist > 0 ? math.max(10, math.min(99, 100 * (1 - (dist1 / avg_dist)))) : 0

        float hist_base1 = close[idx1]
        float hist_future1 = close[idx1 - projection_length]
        float ratio1 = hist_base1 > 0 ? hist_future1 / hist_base1 : 1

        float hist_base2 = idx2 > 0 ? close[idx2] : hist_base1
        float hist_future2 = idx2 > 0 ? close[idx2 - projection_length] : hist_future1
        float ratio2 = hist_base2 > 0 ? hist_future2 / hist_base2 : 1

        float hist_base3 = idx3 > 0 ? close[idx3] : hist_base1
        float hist_future3 = idx3 > 0 ? close[idx3 - projection_length] : hist_future1
        float ratio3 = hist_base3 > 0 ? hist_future3 / hist_base3 : 1

        dna_target1 := close * ratio1
        dna_move1 := close > 0 ? ((dna_target1 - close) / close) * 100 : 0

        dna_target2 := dna_target1 * ratio2
        dna_move2 := dna_target1 > 0 ? ((dna_target2 - dna_target1) / dna_target1) * 100 : 0

        dna_target3 := dna_target2 * ratio3
        dna_move3 := dna_target2 > 0 ? ((dna_target3 - dna_target2) / dna_target2) * 100 : 0

        float fusion_liq_factor = math.max(-0.12, math.min(0.12, pressure_score * math.min(volume_ratio, 3.0) / 3.0 * 0.12))

        dna_fusion_target1 := close * math.max(0.80, math.min(1.25, ratio1 * (1.0 + fusion_liq_factor)))
        dna_fusion_target2 := dna_fusion_target1 * math.max(0.80, math.min(1.35, ratio2 * (1.0 + fusion_liq_factor)))
        dna_fusion_target3 := dna_fusion_target2 * math.max(0.80, math.min(1.50, ratio3 * (1.0 + fusion_liq_factor)))

        dna_fusion_move1 := close > 0 ? ((dna_fusion_target1 - close) / close) * 100 : 0
        dna_fusion_move2 := dna_fusion_target1 > 0 ? ((dna_fusion_target2 - dna_fusion_target1) / dna_fusion_target1) * 100 : 0
        dna_fusion_move3 := dna_fusion_target2 > 0 ? ((dna_fusion_target3 - dna_fusion_target2) / dna_fusion_target2) * 100 : 0

        dna_target_avg := (dna_fusion_target1 + dna_fusion_target2 + dna_fusion_target3) / 3.0
        dna_move_avg := close > 0 ? ((dna_target_avg - close) / close) * 100 : 0
        dna_bull_avg := dna_target_avg > close

float dna_conf_safe = nz(dna_confidence, 0)
bool dna_bull_safe = dna_bull_avg == true
float dna_target_safe = nz(dna_target_avg, close)
float dna_move_safe = nz(dna_move_avg, 0)

float dna_fusion_move1_safe = nz(dna_fusion_move1, 0)
float dna_fusion_move2_safe = nz(dna_fusion_move2, 0)
float dna_fusion_move3_safe = nz(dna_fusion_move3, 0)

// ============================================================================ 
// 13) RISE TYPE / FAKE PUMP DETECTOR
// ============================================================================ 

float rise_base_price = close[fake_rise_lookback]
float rapid_rise_pct = not na(rise_base_price) and rise_base_price > 0 ? (close / rise_base_price - 1.0) * 100.0 : 0.0
bool rapid_rise = rapid_rise_pct >= fake_rise_threshold

float rise_range = math.max(high - low, syminfo.mintick)
float rise_upper_wick_pct = (high - math.max(open, close)) / rise_range * 100.0
bool rise_rejection = rise_upper_wick_pct >= 40.0 and close < low + rise_range * 0.65

bool breakout_above_resistance = not na(rr_res1) and close > rr_res1
bool breakout_hold = breakout_above_resistance and low >= rr_res1 * 0.995 and close > open
bool failed_breakout = not na(rr_res1) and high > rr_res1 and close < rr_res1

bool cmf_weakening = not na(cmf[3]) and cmf < cmf[3]
bool obv_weakening = not na(obv_ema) and obv < obv_ema
bool flow_not_confirmed = not flow_confirm_bull
bool volume_not_supporting = volume_ratio < 1.20

int fake_risk_score = 0
fake_risk_score += rapid_rise and flow_not_confirmed ? 25 : 0
fake_risk_score += rise_rejection ? 20 : 0
fake_risk_score += failed_breakout ? 25 : 0
fake_risk_score += rapid_rise and obv_weakening ? 15 : 0
fake_risk_score += rapid_rise and cmf_weakening ? 10 : 0
fake_risk_score += rapid_rise and volume_not_supporting ? 10 : 0
fake_risk_score := math.min(fake_risk_score, 100)

int rise_confirmation_score = 0
rise_confirmation_score += strong_money_in ? 30 : flow_confirm_bull ? 18 : 0
rise_confirmation_score += volume_ratio >= 1.50 ? 20 : volume_ratio >= 1.20 ? 12 : 0
rise_confirmation_score += breakout_hold ? 15 : 0
rise_confirmation_score += cmf > 0 and obv > obv_ema ? 15 : 0
rise_confirmation_score += maker_bull ? 8 : 0
rise_confirmation_score += trend_bull ? 7 : 0
rise_confirmation_score += has_sector and sector_bull ? 5 : 0
rise_confirmation_score := math.min(rise_confirmation_score, 100)

bool fake_rise_warning = rapid_rise and fake_risk_score >= fake_risk_threshold
bool confirmed_rise = (rapid_rise or breakout_above_resistance) and not fake_rise_warning and rise_confirmation_score >= 60 and (flow_confirm_bull or strong_money_in)
bool weak_rise = (rapid_rise or breakout_above_resistance) and not fake_rise_warning and not confirmed_rise

string rise_type = "⚪ لا يوجد صعود قوي"
color rise_type_color = neutral_color
if fake_rise_warning
    rise_type := "🔴 صعود وهمي"
    rise_type_color := bear_color
else if confirmed_rise
    rise_type := "🟢 صعود مؤكد بالسيولة"
    rise_type_color := bull_color
else if weak_rise
    rise_type := "🟡 صعود غير مكتمل"
    rise_type_color := yellow_color

// ============================================================================ 
// 14) INSTITUTIONAL FLOW ENGINE
// ============================================================================ 

float ife_range = math.max(high - low, syminfo.mintick)
float ife_body = math.abs(close - open)
float ife_upper_wick = high - math.max(open, close)
float ife_lower_wick = math.min(open, close) - low
float ife_close_location = ((close - low) / ife_range) * 100.0
float ife_vol_ratio = nz(volume_ratio, 0)

bool ife_high_volume = ife_vol_ratio >= flow_volume_threshold
bool ife_buy_absorption = ife_high_volume and ife_lower_wick / ife_range >= 0.35 and ife_close_location >= 55 and close >= open[1]
bool ife_sell_absorption = ife_high_volume and ife_upper_wick / ife_range >= 0.35 and ife_close_location <= 45 and close <= open[1]

bool ife_bull_sweep = not na(last_support) and low < last_support and close > last_support and volume_ratio >= 1.05
bool ife_bear_sweep = not na(last_resistance) and high > last_resistance and close < last_resistance and volume_ratio >= 1.05

int accumulation_score = 0
accumulation_score += ife_buy_absorption ? 20 : 0
accumulation_score += ife_bull_sweep ? 20 : 0
accumulation_score += flow_confirm_bull ? 15 : 0
accumulation_score += cmf > cmf[1] ? 10 : 0
accumulation_score += obv > obv[1] ? 10 : 0
accumulation_score += ife_vol_ratio >= 1.20 and close >= open ? 10 : 0
accumulation_score := math.min(accumulation_score, 100)

int distribution_score = 0
distribution_score += ife_sell_absorption ? 20 : 0
distribution_score += ife_bear_sweep ? 20 : 0
distribution_score += flow_confirm_bear ? 15 : 0
distribution_score += cmf < cmf[1] ? 10 : 0
distribution_score += obv < obv[1] ? 10 : 0
distribution_score += ife_vol_ratio >= 1.20 and close <= open ? 10 : 0
distribution_score := math.min(distribution_score, 100)

int smart_money_net = accumulation_score - distribution_score

int manipulation_risk = 0
manipulation_risk += failed_breakout ? 30 : 0
manipulation_risk += rapid_rise and volume_not_supporting ? 20 : 0
manipulation_risk += rapid_rise and obv_weakening ? 20 : 0
manipulation_risk += ife_high_volume and ife_body / ife_range < 0.25 ? 15 : 0
manipulation_risk += (ife_bull_sweep or ife_bear_sweep) and not (flow_confirm_bull or flow_confirm_bear) ? 15 : 0
manipulation_risk := math.min(manipulation_risk, 100)

bool institutional_accumulation = accumulation_score >= 60 and accumulation_score > distribution_score + 10
bool institutional_distribution = distribution_score >= 60 and distribution_score > accumulation_score + 10

string smart_money_state = institutional_accumulation ? "🟢 تجميع محتمل" : institutional_distribution ? "🔴 تصريف محتمل" : smart_money_net >= 15 ? "🟢 ميل شرائي" : smart_money_net <= -15 ? "🔴 ميل بيعي" : "⚪ محايد"
color smart_money_color = institutional_accumulation or smart_money_net >= 15 ? bull_color : institutional_distribution or smart_money_net <= -15 ? bear_color : yellow_color
string absorption_state = ife_buy_absorption ? "شراء" : ife_sell_absorption ? "بيع" : "لا يوجد"
string manipulation_state = manipulation_risk >= 60 ? "🔴 مرتفع" : manipulation_risk >= 35 ? "🟡 متوسط" : "🟢 منخفض"

// ============================================================================
// 9B) WHO IS BUYING? - Institutional vs Retail Proxy
// IMPORTANT: TradingView OHLCV cannot identify trader identity directly.
// This engine estimates the participant type from size, persistence, absorption,
// VWAP behavior, MFI/CMF/OBV and a proxy CVD (not true order-flow CVD).
// ============================================================================
float who_mfi = ta.mfi(hlc3, who_mfi_length)
float who_vwap = ta.vwap(hlc3)
float who_vwap_dist = who_vwap != 0 ? (close - who_vwap) / who_vwap * 100 : 0

// Delta proxy: positive when the candle closes toward its high, negative toward low.
float who_delta = volume * pressure_score
float who_cvd = ta.cum(who_delta)
float who_cvd_ema = ta.ema(who_cvd, who_lookback)

float who_delta_avg = ta.sma(who_delta, who_lookback)
float who_delta_persistence = ta.sma(who_delta > 0 ? 100.0 : who_delta < 0 ? 0.0 : 50.0, who_lookback)
float who_volume_factor = math.min(volume_ratio / who_volume_threshold, 2.0) * 50.0

bool who_large_buy = volume_ratio >= who_volume_threshold and who_delta > 0 and close >= open
bool who_large_sell = volume_ratio >= who_volume_threshold and who_delta < 0 and close <= open
bool who_vwap_bull = close > who_vwap
bool who_vwap_bear = close < who_vwap
bool who_cvd_bull = who_cvd > who_cvd_ema and who_delta_avg > 0
bool who_cvd_bear = who_cvd < who_cvd_ema and who_delta_avg < 0

// Institutional proxy: large/abnormal volume + persistence + absorption/flow confirmation.
// Retail proxy: weaker volume + price chasing/oscillation without institutional confirmation.
int institutional_buy_score = 0
institutional_buy_score += who_large_buy ? 25 : 0
institutional_buy_score += who_volume_factor >= 50 ? 15 : 0
institutional_buy_score += who_vwap_bull ? 10 : 0
institutional_buy_score += who_cvd_bull ? 15 : 0
institutional_buy_score += who_mfi >= 55 ? 10 : 0
institutional_buy_score += cmf > 0 ? 10 : 0
institutional_buy_score += obv > obv_ema ? 10 : 0
institutional_buy_score += (ife_buy_absorption or ife_bull_sweep) ? 15 : 0
institutional_buy_score := math.min(institutional_buy_score, 100)

int institutional_sell_score = 0
institutional_sell_score += who_large_sell ? 25 : 0
institutional_sell_score += who_volume_factor >= 50 ? 15 : 0
institutional_sell_score += who_vwap_bear ? 10 : 0
institutional_sell_score += who_cvd_bear ? 15 : 0
institutional_sell_score += who_mfi <= 45 ? 10 : 0
institutional_sell_score += cmf < 0 ? 10 : 0
institutional_sell_score += obv < obv_ema ? 10 : 0
institutional_sell_score += (ife_sell_absorption or ife_bear_sweep) ? 15 : 0
institutional_sell_score := math.min(institutional_sell_score, 100)

// Retail is inferred only when flow is directional but institutional evidence is weak.
int retail_buy_score = 0
retail_buy_score += who_delta > 0 ? 20 : 0
retail_buy_score += volume_ratio < who_volume_threshold ? 20 : 0
retail_buy_score += who_vwap_bull ? 10 : 0
retail_buy_score += who_mfi >= 55 ? 10 : 0
retail_buy_score += not who_large_buy ? 10 : 0
retail_buy_score += not who_cvd_bull ? 10 : 0
retail_buy_score := math.min(retail_buy_score, 100)

int retail_sell_score = 0
retail_sell_score += who_delta < 0 ? 20 : 0
retail_sell_score += who_delta_persistence <= 40 ? 20 : 0
retail_sell_score += volume_ratio < who_volume_threshold ? 20 : 0
retail_sell_score += who_vwap_bear ? 10 : 0
retail_sell_score += who_mfi <= 45 ? 10 : 0
retail_sell_score += not who_large_sell ? 10 : 0
retail_sell_score += not who_cvd_bear ? 10 : 0
retail_sell_score := math.min(retail_sell_score, 100)

int who_buying_score = institutional_buy_score - institutional_sell_score
int who_retail_score = retail_buy_score - retail_sell_score

string who_state = "⚪ مختلط/غير واضح"
color who_color = neutral_color
if institutional_buy_score >= who_inst_threshold and institutional_buy_score > institutional_sell_score + 10
    who_state := "🏦 شراء مؤسساتي محتمل"
    who_color := bull_color
else if institutional_sell_score >= who_inst_threshold and institutional_sell_score > institutional_buy_score + 10
    who_state := "🏦 بيع/تصريف مؤسساتي محتمل"
    who_color := bear_color
else if retail_buy_score >= who_retail_threshold and retail_buy_score > institutional_buy_score + 5
    who_state := "👤 شراء أفراد محتمل"
    who_color := cyan_color
else if retail_sell_score >= who_retail_threshold and retail_sell_score > institutional_sell_score + 5
    who_state := "👤 بيع أفراد محتمل"
    who_color := orange_color
else if who_buying_score >= 15
    who_state := "🟢 ميل شرائي مختلط"
    who_color := bull_color
else if who_buying_score <= -15
    who_state := "🔴 ميل بيعي مختلط"
    who_color := bear_color

string who_confidence = math.max(math.max(institutional_buy_score, institutional_sell_score), math.max(retail_buy_score, retail_sell_score)) >= 80 ? "عالية" : math.max(math.max(institutional_buy_score, institutional_sell_score), math.max(retail_buy_score, retail_sell_score)) >= 65 ? "متوسطة" : "منخفضة"

// ============================================================================ 
// 15) ACCUMULATION / DISTRIBUTION PHASE + MTF
// ============================================================================ 

float ad_range = math.max(high - low, syminfo.mintick)
float ad_body_pct = math.abs(close - open) / ad_range
float ad_close_pos = (close - low) / ad_range
float ad_avg_vol20 = ta.sma(volume, 20)
float ad_rel_vol20 = ad_avg_vol20 > 0 ? volume / ad_avg_vol20 : 0.0
float ad_range_avg20 = ta.sma(high - low, 20)

float ad_ema20_val = ta.ema(close, 20)

bool ad_compression = not na(ad_range_avg20) and (high - low) < ad_range_avg20 * 0.80
bool ad_accumulation_bar = ad_rel_vol20 >= 1.20 and ad_close_pos >= 0.60 and close >= open
bool ad_distribution_bar = ad_rel_vol20 >= 1.20 and ad_close_pos <= 0.40 and close <= open
bool ad_absorption_buy = ad_rel_vol20 >= 1.40 and ad_close_pos >= 0.65 and ad_body_pct < 0.45
bool ad_absorption_sell = ad_rel_vol20 >= 1.40 and ad_close_pos <= 0.35 and ad_body_pct < 0.45
float ad_range_high = ta.highest(high, 20)[1]
float ad_range_low = ta.lowest(low, 20)[1]
bool ad_breakout_up = not na(ad_range_high) and close > ad_range_high
bool ad_breakout_down = not na(ad_range_low) and close < ad_range_low
bool ad_failed_up = not na(ad_range_high) and high > ad_range_high and close < ad_range_high
bool ad_failed_down = not na(ad_range_low) and low < ad_range_low and close > ad_range_low

int ad_acc_score = 0
ad_acc_score += ad_accumulation_bar ? 25 : 0
ad_acc_score += ad_absorption_buy ? 25 : 0
ad_acc_score += ad_compression and close >= ad_ema20_val ? 15 : 0
ad_acc_score += institutional_accumulation ? 25 : 0
ad_acc_score += ad_breakout_up and ad_rel_vol20 >= 1.20 ? 10 : 0
ad_acc_score := math.min(ad_acc_score, 100)

int ad_dist_score = 0
ad_dist_score += ad_distribution_bar ? 25 : 0
ad_dist_score += ad_absorption_sell ? 25 : 0
ad_dist_score += ad_compression and close <= ad_ema20_val ? 15 : 0
ad_dist_score += institutional_distribution ? 25 : 0
ad_dist_score += ad_breakout_down and ad_rel_vol20 >= 1.20 ? 10 : 0
ad_dist_score := math.min(ad_dist_score, 100)

string ad_phase = ad_acc_score >= 65 and ad_acc_score > ad_dist_score ? "تجميع متقدم" : ad_acc_score >= 40 and ad_acc_score > ad_dist_score ? "تجميع محتمل" : ad_dist_score >= 65 and ad_dist_score > ad_acc_score ? "تصريف متقدم" : ad_dist_score >= 40 and ad_dist_score > ad_acc_score ? "تصريف محتمل" : "مرحلة محايدة"
color ad_phase_color = ad_acc_score > ad_dist_score and ad_acc_score >= 40 ? bull_color : ad_dist_score > ad_acc_score and ad_dist_score >= 40 ? bear_color : yellow_color

bool ad_fake_rise = ad_failed_up or (rapid_rise and (volume_not_supporting or obv_weakening)) or failed_breakout
int ad_fake_score = 0
ad_fake_score += ad_failed_up ? 40 : 0
ad_fake_score += rapid_rise ? 20 : 0
ad_fake_score += volume_not_supporting ? 20 : 0
ad_fake_score += obv_weakening ? 20 : 0
ad_fake_score := math.min(ad_fake_score, 100)
string ad_rise_diagnosis = ad_fake_score >= 60 ? "تحذير: صعود وهمي محتمل" : ad_breakout_up and ad_rel_vol20 >= 1.20 and not ad_fake_rise ? "اختراق مدعوم نسبيًا" : "لا يوجد تأكيد كافٍ"

float ad_mtf_ema20 = request.security(syminfo.tickerid, "60", ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
float ad_mtf_ema50 = request.security(syminfo.tickerid, "60", ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
float ad_mtf_close = request.security(syminfo.tickerid, "60", close, barmerge.gaps_off, barmerge.lookahead_off)
bool ad_mtf_bull = ad_mtf_close > ad_mtf_ema20 and ad_mtf_ema20 > ad_mtf_ema50
bool ad_mtf_bear = ad_mtf_close < ad_mtf_ema20 and ad_mtf_ema20 < ad_mtf_ema50
string ad_mtf_state = ad_mtf_bull ? "H1 صاعد" : ad_mtf_bear ? "H1 هابط" : "H1 محايد"
color ad_mtf_color = ad_mtf_bull ? bull_color : ad_mtf_bear ? bear_color : yellow_color
bool ad_confirmed_breakout = ad_breakout_up and ad_rel_vol20 >= 1.20 and ad_mtf_bull and not ad_fake_rise

// ============================================================================ 
// 16) SCORE ENGINE
// ============================================================================ 

int trend_weight = 10
int ma_weight = 10
int macd_weight = 10
int ichimoku_weight = 10
int maker_weight = 15
int rsi_weight = 5
int volume_weight = 10
int pivot_weight = 5
int market_weight = 5
int sector_weight = 5
int dna_weight = 5
int fair_weight = 5
int liquidity_weight = 5
int money_flow_weight = 10
int wyckoff_weight = 15

if trade_mode == "حذر"
    trend_weight := 15
    ma_weight := 15
    ichimoku_weight := 15
    wyckoff_weight := 15
    maker_weight := 10
    macd_weight := 5
    pivot_weight := 10
    dna_weight := 3
else if trade_mode == "هجومي"
    trend_weight := 5
    ma_weight := 5
    ichimoku_weight := 5
    wyckoff_weight := 10
    maker_weight := 20
    macd_weight := 15
    volume_weight := 15
    dna_weight := 10

int raw_score = 0
raw_score += trend_bull ? trend_weight : trend_bear ? -trend_weight : 0
raw_score += ma_bull_align ? ma_weight : ma_bear_align ? -ma_weight : 0
raw_score += macd_bull ? macd_weight : macd_bear ? -macd_weight : 0
raw_score += ichimoku_strong_bull ? ichimoku_weight : ichimoku_strong_bear ? -ichimoku_weight : 0
raw_score += maker_bull ? maker_weight : maker_bear ? -maker_weight : 0
raw_score += rsi >= 50 and rsi < 70 ? rsi_weight : rsi < 40 ? -rsi_weight : 0
raw_score += volume_surge and close > open ? volume_weight : volume_surge and close < open ? -volume_weight : 0
raw_score += above_pivot ? pivot_weight : -pivot_weight
raw_score += outperform_market ? market_weight : -market_weight
raw_score += has_sector and sector_bull ? sector_weight : has_sector and sector_bear ? -sector_weight : 0
raw_score += dna_bull_safe and dna_conf_safe > 60 ? dna_weight : not dna_bull_safe and dna_conf_safe > 60 ? -dna_weight : 0
raw_score += fair_premium < 5 ? fair_weight : fair_premium > 10 ? -fair_weight : 0
raw_score += liquidity_state == "🟢 سيولة قوية داخلة" ? liquidity_weight : liquidity_state == "🔴 سيولة قوية خارجة" ? -liquidity_weight : 0
raw_score += strong_money_in ? money_flow_weight : strong_money_out ? -money_flow_weight : flow_confirm_bull ? math.round(money_flow_weight * 0.35) : flow_confirm_bear ? -math.round(money_flow_weight * 0.35) : 0
// WHO IS BUYING? contribution: only strong institutional/retail direction is allowed to affect the final score.
raw_score += institutional_buy_score >= who_inst_threshold ? 8 : institutional_sell_score >= who_inst_threshold ? -8 : retail_buy_score >= who_retail_threshold ? 3 : retail_sell_score >= who_retail_threshold ? -3 : 0
raw_score += accumulation_phase ? wyckoff_weight : distribution_phase ? -wyckoff_weight : 0
raw_score += fake_rise_warning ? -15 : confirmed_rise ? 10 : weak_rise ? -3 : 0

int max_score = trend_weight + ma_weight + macd_weight + ichimoku_weight + maker_weight + rsi_weight + volume_weight + pivot_weight + market_weight + sector_weight + dna_weight + fair_weight + liquidity_weight + money_flow_weight + wyckoff_weight
int score = max_score > 0 ? int(math.round(50 + raw_score * 50.0 / max_score)) : 50
score := math.max(0, math.min(score, 100))

// ============================================================================ 
// 17) FINAL SIGNAL
// ============================================================================ 

string signal = "انتظار"
color signal_color = neutral_color

if fake_rise_warning
    signal := "🔴 صعود وهمي"
    signal_color := bear_color
else if score >= 80 and trend_bull and above_pivot and strong_money_in
    signal := "🟢 شراء قوي"
    signal_color := bull_color
else if score >= 65
    signal := "🟢 إيجابي"
    signal_color := bull_color
else if score <= 25 and trend_bear
    signal := "🔴 تجنب"
    signal_color := bear_color
else if score <= 40
    signal := "🔴 سلبي"
    signal_color := bear_color

float confidence_score = math.max(5, math.min(95, 50 + (score - 50) * 0.90))

// ============================================================================ 
// 18) ANALYTICAL REASON ENGINE
// ============================================================================ 

string analysis_reason = ""
if fake_rise_warning
    analysis_reason := "🚨 تحذير: صعود وهمي محتمل.\n• الصعود السريع: " + str.tostring(rapid_rise_pct, "#.##") + "%.\n"
    analysis_reason += flow_not_confirmed ? "• السيولة لا تؤكد الحركة.\n" : ""
    analysis_reason += rise_rejection ? "• توجد شمعة رفض.\n" : ""
else if signal == "🟢 شراء قوي" or signal == "🟢 إيجابي"
    analysis_reason := "📊 أسباب الصعود المتوقعة:\n"
    if accumulation_phase
        analysis_reason += "• السهم في مرحلة تجميع (Accumulation).\n"
    if smart_buy
        analysis_reason += "• رصد بصمة ميكر شرائية (Smart Buy).\n"
    if ma_bull_align
        analysis_reason += "• توافق المتوسطات صاعد.\n"
    if macd_bull
        analysis_reason += "• الماكد إيجابي.\n"
    if ichimoku_bull
        analysis_reason += "• السعر فوق سحابة الايشيموكو.\n"
    if strong_money_in
        analysis_reason += "• دخول سيولة تقديري قوي.\n"
    if dna_bull_safe and dna_conf_safe > 60
        analysis_reason += "• المسار المتصل (DNA) يتوقع " + str.tostring(dna_move_safe, "#.##") + "%.\n"
else if signal == "🔴 تجنب" or signal == "🔴 سلبي"
    analysis_reason := "📉 أسباب الهبوط/الضعف:\n"
    if distribution_phase
        analysis_reason += "• السهم في مرحلة تصريف (Distribution).\n"
    if smart_sell
        analysis_reason += "• رصد بصمة ميكر بيعية (Smart Sell).\n"
    if ma_bear_align
        analysis_reason += "• توافق المتوسطات هابط.\n"
    if strong_money_out
        analysis_reason += "• خروج سيولة تقديري قوي.\n"
else
    analysis_reason := "⚖️ السهم في وضع عرضي/تذبذب.\n• لا توجد إشارة قوية متكاملة حالياً.\n"

// ============================================================================ 
// 19) BEST ENTRY ENGINE (مطور ليكون منطقياً وواقعياً للدخول)
// ============================================================================ 

float best_entry_price = close
string best_entry_reason = "🟢 الدخول الآن (السعر مدعوم)"
string entry_mode = "Aggressive"

// مسافة الارتداد المقبولة (لا تتجاوز 0.75 من الـ ATR لتكون واقعية)
float max_pullback_dist = atr * 0.75
float shallow_pullback = close - (atr * 0.382) // ارتداد بسيط 38.2% كنقطة دخول منطقية

// التحقق من قرب السعر من الدعم الديناميكي أو متوسط 20
float pb_sup = (not na(rr_sup1) and rr_sup1 < close and (close - rr_sup1) <= max_pullback_dist) ? rr_sup1 : na
float pb_ema = (not na(ema20) and ema20 < close and (close - ema20) <= max_pullback_dist) ? ema20 : na

bool price_overextended = (close - ema20) > (atr * 1.5)

if fake_rise_warning
    best_entry_reason := "🔴 ممنوع الدخول: صعود وهمي"
    entry_mode := "Wait"
else if score >= 65 and trend_bull
    // 1. الدخول عند الدعم القريب
    if not na(pb_sup)
        best_entry_price := pb_sup
        best_entry_reason := "🟢 دخول عند الدعم القريب"
        entry_mode := "Support Bounce"
    // 2. الدخول عند EMA20 القريب
    else if not na(pb_ema)
        best_entry_price := pb_ema
        best_entry_reason := "🟢 دخول عند EMA20"
        entry_mode := "EMA20 Bounce"
    // 3. السعر ممتد والدعوم بعيدة -> اقتراح ارتداد بسيط
    else if price_overextended
        best_entry_price := shallow_pullback
        best_entry_reason := "⏳ انتظر تصحيح بسيط"
        entry_mode := "Shallow Pullback"
    // 4. الزخم قوي والسعر غير ممتد -> الدخول فوراً
    else
        best_entry_price := close
        best_entry_reason := "🟢 دخول فوري (زخم قوي)"
        entry_mode := "Momentum"
else if score < 60
    best_entry_reason := "⚪ انتظر إشارة أقوى"
    entry_mode := "Wait"
else
    best_entry_price := close
    entry_mode := "Watch"

// ============================================================================ 
// 20) RISK / REWARD (يعتمد على الدعوم الديناميكية)
// ============================================================================ 

float atr_pctrank = nz(ta.percentrank(atr, 100), 50)
float atr_mult = atr_pctrank > 80 ? 2.0 : atr_pctrank < 20 ? 1.1 : 1.5

float technical_stop = not na(rr_sup1) and rr_sup1 < close ? rr_sup1 - atr * 0.25 : close - atr * atr_mult
float stop_loss = technical_stop < close ? technical_stop : close - atr * atr_mult
float risk_per_share = close - stop_loss

float tp1 = close + risk_per_share * 1.0
float tp2 = close + risk_per_share * 1.5
float tp3 = close + risk_per_share * 2.0

if not na(rr_res1) and rr_res1 > close
    tp1 := math.min(tp1, rr_res1)
if not na(rr_res2) and rr_res2 > close
    tp2 := math.min(tp2, rr_res2)
if not na(rr_res3) and rr_res3 > close
    tp3 := math.min(tp3, rr_res3)

tp1 := math.max(tp1, close + risk_per_share * 0.5) 
tp2 := math.max(tp2, tp1 + risk_per_share * 0.5)
tp3 := math.max(tp3, tp2 + risk_per_share * 0.5)

float tp1_pct = close > 0 ? ((tp1 - close) / close) * 100 : 0
float tp2_pct = close > 0 ? ((tp2 - close) / close) * 100 : 0
float tp3_pct = close > 0 ? ((tp3 - close) / close) * 100 : 0
float sl_pct = close > 0 ? ((close - stop_loss) / close) * 100 : 0

// ============================================================================ 
// 21) VISUALS & PLOTS
// ============================================================================ 

bool bull_ob = close[1] < open[1] and close > open and close > high[1]
bool bear_ob = close[1] > open[1] and close < open and close < low[1]
if show_smc and bull_ob
    box.new(bar_index-1, high[1], bar_index+10, low[1], border_color=color.new(color.blue, 50), bgcolor=color.new(color.blue, 85), text="OB")
if show_smc and bear_ob
    box.new(bar_index-1, high[1], bar_index+10, low[1], border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 85), text="OB")

plotshape(show_makers and smart_buy, title="Smart Buy", style=shape.triangleup, location=location.belowbar, color=color.blue, size=size.small, text="MEKKER BUY")
plotshape(show_makers and smart_sell, title="Smart Sell", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="MEKKER SELL")
plotshape(show_makers and absorption, title="Absorption", style=shape.circle, location=location.belowbar, color=bull_color, size=size.tiny, text="جمع")
plotshape(show_makers and distribution, title="Distribution", style=shape.circle, location=location.abovebar, color=bear_color, size=size.tiny, text="تصريف")
plotshape(fake_rise_warning, title="Fake Rise", style=shape.labeldown, location=location.abovebar, color=bear_color, textcolor=color.white, size=size.tiny, text="FAKE")

var line dna_line1 = na
var label dna_lbl1 = na
var line dna_line2 = na
var label dna_lbl2 = na
var line dna_line3 = na
var label dna_lbl3 = na

if barstate.islast and show_dna and not na(dna_fusion_target1)
    if not na(dna_line1)
        line.delete(dna_line1)
        label.delete(dna_lbl1)
        line.delete(dna_line2)
        label.delete(dna_lbl2)
        line.delete(dna_line3)
        label.delete(dna_lbl3)

    dna_line1 := line.new(bar_index, close, bar_index + projection_length, dna_fusion_target1, xloc=xloc.bar_index, color=dna_fusion_move1_safe >= 0 ? bull_color : bear_color, width=3, style=line.style_solid)
    dna_lbl1 := label.new(bar_index + projection_length, dna_fusion_target1, "DNA 1\n" + str.tostring(dna_fusion_move1_safe, "#.##") + "%", xloc=xloc.bar_index, color=dna_fusion_move1_safe >= 0 ? bull_color : bear_color, textcolor=color.white, style=label.style_label_left, size=size.tiny)

    dna_line2 := line.new(bar_index + projection_length, dna_fusion_target1, bar_index + projection_length * 2, dna_fusion_target2, xloc=xloc.bar_index, color=dna_fusion_move2_safe >= 0 ? bull_color : bear_color, width=2, style=line.style_dashed)
    dna_lbl2 := label.new(bar_index + projection_length * 2, dna_fusion_target2, "DNA 2\n" + str.tostring(dna_fusion_move2_safe, "#.##") + "%", xloc=xloc.bar_index, color=dna_fusion_move2_safe >= 0 ? bull_color : bear_color, textcolor=color.white, style=label.style_label_left, size=size.tiny)

    dna_line3 := line.new(bar_index + projection_length * 2, dna_fusion_target2, bar_index + projection_length * 3, dna_fusion_target3, xloc=xloc.bar_index, color=dna_fusion_move3_safe >= 0 ? bull_color : bear_color, width=2, style=line.style_dotted)
    dna_lbl3 := label.new(bar_index + projection_length * 3, dna_fusion_target3, "DNA 3\n" + str.tostring(dna_fusion_move3_safe, "#.##") + "%", xloc=xloc.bar_index, color=dna_fusion_move3_safe >= 0 ? bull_color : bear_color, textcolor=color.white, style=label.style_label_left, size=size.tiny)

var label reason_label = na
if barstate.islast and show_reason
    if not na(reason_label)
        label.delete(reason_label)
    bool bullish_signal = signal == "🟢 شراء قوي" or signal == "🟢 إيجابي"
    string short_reason = bullish_signal ? "📈 أسباب الصعود" : signal == "🔴 تجنب" or signal == "🔴 سلبي" ? "📉 أسباب الضعف" : "⚖️ وضع عرضي"
    float reason_y = bullish_signal ? low - atr * 2 : high + atr * 2
    reason_label := label.new(bar_index, reason_y, short_reason + "\n" + analysis_reason, color=color.new(signal_color, 10), textcolor=color.white, style=bullish_signal ? label.style_label_up : label.style_label_down, size=size.small)

// ============================================================================ 
// 22) DASHBOARD (تم تحديث صفوف الدخول)
// ============================================================================ 

var table dash = table.new(position.top_right, 5, 29, bgcolor=bg_main, frame_color=color.rgb(70, 85, 100), frame_width=1, border_color=color.rgb(50, 65, 80), border_width=1)

f_cell(int col, int row, string txt, color txtColor, color cellBg) =>
    table.cell(dash, col, row, txt, text_color=txtColor, bgcolor=cellBg, text_halign=text.align_center, text_valign=text.align_center, text_size=size.small)

if barstate.islast
    // 0
    table.cell(dash, 0, 0, "🎯 V60.2 | " + syminfo.ticker, text_color=color.white, bgcolor=bg_header, text_halign=text.align_center, text_size=size.normal)
    table.cell(dash, 1, 0, "SCORE", text_color=color.white, bgcolor=bg_header)
    table.cell(dash, 2, 0, "الإشارة", text_color=color.white, bgcolor=bg_header)
    table.cell(dash, 3, 0, "Phase (وايكوف)", text_color=color.white, bgcolor=bg_header)
    table.cell(dash, 4, 0, "النمط", text_color=color.white, bgcolor=bg_header)
    
    // 1
    f_cell(0, 1, "القرار النهائي", neutral_color, bg_section)
    f_cell(1, 1, str.tostring(score) + "%", score >= 65 ? bull_color : score <= 40 ? bear_color : yellow_color, bg_cell)
    f_cell(2, 1, signal, signal_color, bg_cell)
    f_cell(3, 1, wyckoff_phase, wyckoff_color, bg_cell)
    f_cell(4, 1, trade_mode, cyan_color, bg_cell)

    // 2
    f_cell(0, 2, "📈 الماكد (MACD)", neutral_color, bg_section)
    f_cell(1, 2, macd_bull ? "🟢 صاعد" : macd_bear ? "🔴 هابط" : "🟡 محايد", macd_bull ? bull_color : macd_bear ? bear_color : yellow_color, bg_cell)
    f_cell(2, 2, "الايشيموكو", neutral_color, bg_section)
    f_cell(3, 2, ichimoku_state, ichimoku_color, bg_cell)
    f_cell(4, 2, str.tostring(nz(macd_hist, 0), "#.###"), nz(macd_hist, 0) > 0 ? bull_color : bear_color, bg_cell)

    // 3
    f_cell(0, 3, "توافق المتوسطات", neutral_color, bg_section)
    f_cell(1, 3, ma_bull_align ? "🟢 10>20>50>200" : ma_bear_align ? "🔴 هابط" : "🟡 غير مرتب", ma_bull_align ? bull_color : ma_bear_align ? bear_color : yellow_color, bg_cell)
    f_cell(2, 3, "RSI", neutral_color, bg_section)
    f_cell(3, 3, str.tostring(rsi, "#.##"), rsi_color, bg_cell)
    f_cell(4, 3, rsi_state, rsi_color, bg_cell)

    // 4
    f_cell(0, 4, "Volume", neutral_color, bg_section)
    f_cell(1, 4, str.tostring(volume_ratio, "#.##") + "x", volume_ratio >= 1.3 ? bull_color : neutral_color, bg_cell)
    f_cell(2, 4, "السيولة", neutral_color, bg_section)
    f_cell(3, 4, liquidity_state, liquidity_state == "🟢 سيولة قوية داخلة" ? bull_color : liquidity_state == "🔴 سيولة قوية خارجة" ? bear_color : neutral_color, bg_cell)
    f_cell(4, 4, maker_state, maker_bull ? bull_color : maker_bear ? bear_color : neutral_color, bg_cell)

    // 5
    f_cell(0, 5, "🟢 شراء تقديري", neutral_color, bg_section)
    f_cell(1, 5, str.tostring(estimated_buy_volume, "#") + " سهم", bull_color, bg_cell)
    f_cell(2, 5, "🔴 بيع تقديري", neutral_color, bg_section)
    f_cell(3, 5, str.tostring(estimated_sell_volume, "#") + " سهم", bear_color, bg_cell)
    f_cell(4, 5, money_flow_state + " | " + (flow_confirm_bull ? "CMF/OBV+" : flow_confirm_bear ? "CMF/OBV-" : "تأكيد ضعيف"), money_flow_color, bg_cell)

    // 6
    f_cell(0, 6, "💰 قيمة شراء", neutral_color, bg_section)
    f_cell(1, 6, str.tostring(estimated_buy_value_m, "#.##") + " M", bull_color, bg_cell)
    f_cell(2, 6, "💰 قيمة بيع", neutral_color, bg_section)
    f_cell(3, 6, str.tostring(estimated_sell_value_m, "#.##") + " M", bear_color, bg_cell)
    f_cell(4, 6, "Net " + str.tostring(net_flow_m, "#.##") + " M", net_flow_m >= 0 ? bull_color : bear_color, bg_cell)

    // 7
    f_cell(0, 7, "القطاع", neutral_color, bg_section)
    f_cell(1, 7, sector_name, cyan_color, bg_cell)
    f_cell(2, 7, "حالة القطاع", neutral_color, bg_section)
    f_cell(3, 7, sector_state, sector_money_in ? bull_color : sector_money_out ? bear_color : yellow_color, bg_cell)
    f_cell(4, 7, has_sector ? str.tostring(stock_vs_sector, "#.##") + "%" : "N/A", has_sector ? (stock_vs_sector >= 0 ? bull_color : bear_color) : neutral_color, bg_cell)

    // 8
    f_cell(0, 8, "Pivot", neutral_color, bg_section)
    f_cell(1, 8, str.tostring(pivot, format.mintick), above_pivot ? bull_color : bear_color, bg_cell)
    f_cell(2, 8, "Fair Value", neutral_color, bg_section)
    f_cell(3, 8, str.tostring(fair_premium, "#.##") + "%", fair_premium <= 5 ? bull_color : bear_color, bg_cell)
    f_cell(4, 8, volatility_state, expansion ? orange_color : squeeze ? purple_color : neutral_color, bg_cell)

    // 9 (الدعوم الديناميكية)
    f_cell(0, 9, "🛡️ الدعوم الديناميكية", neutral_color, bg_section)
    f_cell(1, 9, "S1 " + (not na(rr_sup1) ? str.tostring(rr_sup1, "#.##") : "N/A"), bull_color, bg_cell)
    f_cell(2, 9, "S2 " + (not na(rr_sup2) ? str.tostring(rr_sup2, "#.##") : "N/A"), bull_color, bg_cell)
    f_cell(3, 9, "S3 " + (not na(rr_sup3) ? str.tostring(rr_sup3, "#.##") : "N/A"), bull_color, bg_cell)
    f_cell(4, 9, "Swing " + (not na(last_support) ? str.tostring(last_support, "#.##") : "N/A"), cyan_color, bg_cell)

    // 10 (المقاومات الديناميكية)
    f_cell(0, 10, "🚧 المقاومات الديناميكية", neutral_color, bg_section)
    f_cell(1, 10, "R1 " + (not na(rr_res1) ? str.tostring(rr_res1, "#.##") : "N/A"), bear_color, bg_cell)
    f_cell(2, 10, "R2 " + (not na(rr_res2) ? str.tostring(rr_res2, "#.##") : "N/A"), bear_color, bg_cell)
    f_cell(3, 10, "R3 " + (not na(rr_res3) ? str.tostring(rr_res3, "#.##") : "N/A"), bear_color, bg_cell)
    f_cell(4, 10, "Swing " + (not na(last_resistance) ? str.tostring(last_resistance, "#.##") : "N/A"), orange_color, bg_cell)

    // 11
    f_cell(0, 11, "🎯 TP1", white_color, bg_section)
    f_cell(1, 11, str.tostring(tp1, "#.##") + " (+" + str.tostring(tp1_pct, "#.##") + "%)", bull_color, bg_cell)
    f_cell(2, 11, "TP2", white_color, bg_section)
    f_cell(3, 11, str.tostring(tp2, "#.##") + " (+" + str.tostring(tp2_pct, "#.##") + "%)", bull_color, bg_cell)
    f_cell(4, 11, "TP3 " + str.tostring(tp3, "#.##") + " (+" + str.tostring(tp3_pct, "#.##") + "%)", bull_color, bg_cell)

    // 12
    f_cell(0, 12, "وقف الخسارة", neutral_color, bg_section)
    f_cell(1, 12, str.tostring(stop_loss, "#.##") + " (-" + str.tostring(sl_pct, "#.##") + "%)", bear_color, bg_cell)
    f_cell(2, 12, "Risk/Share", neutral_color, bg_section)
    f_cell(3, 12, str.tostring(risk_per_share, "#.##"), orange_color, bg_cell)
    f_cell(4, 12, "RR 1:" + str.tostring(risk_per_share > 0 ? (tp1 - close) / risk_per_share : 0, "#.##"), cyan_color, bg_cell)

    // 13
    f_cell(0, 13, "🧬 DNA 1 + LIQ", neutral_color, bg_section)
    f_cell(1, 13, str.tostring(dna_fusion_move1_safe, "#.##") + "%", dna_fusion_move1_safe >= 0 ? bull_color : bear_color, bg_cell)
    f_cell(2, 13, "DNA 2 + LIQ", neutral_color, bg_section)
    f_cell(3, 13, str.tostring(dna_fusion_move2_safe, "#.##") + "%", dna_fusion_move2_safe >= 0 ? bull_color : bear_color, bg_cell)
    f_cell(4, 13, "DNA 3 " + str.tostring(dna_fusion_move3_safe, "#.##") + "%", dna_fusion_move3_safe >= 0 ? bull_color : bear_color, bg_cell)

    // 14
    f_cell(0, 14, "🧬 المسار الكلي", neutral_color, bg_section)
    f_cell(1, 14, str.tostring(dna_move_safe, "#.##") + "%", dna_bull_safe ? bull_color : bear_color, bg_cell)
    f_cell(2, 14, "الهدف النهائي", neutral_color, bg_section)
    f_cell(3, 14, str.tostring(dna_target_safe, "#.##"), cyan_color, bg_cell)
    f_cell(4, 14, "ثقة " + str.tostring(dna_conf_safe, "#") + "%", dna_conf_safe > 70 ? bull_color : yellow_color, bg_cell)

    // 15 (تم تحديثها لتعرض السعر والإجراء ونوع الدخول بوضوح)
    f_cell(0, 15, "🎯 أفضل دخول", white_color, bg_section)
    f_cell(1, 15, str.tostring(best_entry_price, format.mintick), cyan_color, bg_cell)
    f_cell(2, 15, "الإجراء", neutral_color, bg_section)
    f_cell(3, 15, best_entry_reason, fake_rise_warning ? bear_color : score >= 65 ? bull_color : yellow_color, bg_cell)
    f_cell(4, 15, "Mode: " + entry_mode, neutral_color, bg_cell)

    // 16 (منطقة الدخول التفصيلية)
    f_cell(0, 16, "📍 منطقة الدخول", neutral_color, bg_section)
    f_cell(1, 16, str.tostring(best_entry_price - atr*0.15, "#.##"), cyan_color, bg_cell)
    f_cell(2, 16, "إلى", neutral_color, bg_section)
    f_cell(3, 16, str.tostring(best_entry_price + atr*0.15, "#.##"), cyan_color, bg_cell)
    f_cell(4, 16, "السعر الحالي: " + str.tostring(close, "#.##"), neutral_color, bg_cell)

    // 17
    f_cell(0, 17, "🚨 نوع الصعود", white_color, bg_section)
    f_cell(1, 17, rise_type, rise_type_color, bg_cell)
    f_cell(2, 17, "خطر وهمي", neutral_color, bg_section)
    f_cell(3, 17, str.tostring(fake_risk_score) + "/100", fake_risk_score >= fake_risk_threshold ? bear_color : fake_risk_score >= 35 ? yellow_color : bull_color, bg_cell)
    f_cell(4, 17, "تأكيد " + str.tostring(rise_confirmation_score) + "/100", rise_confirmation_score >= 60 ? bull_color : yellow_color, bg_cell)

    // 18
    f_cell(0, 18, "🔎 تشخيص الصعود", neutral_color, bg_section)
    table.merge_cells(dash, 1, 18, 4, 18)
    f_cell(1, 18, "H1 EMA20/50", neutral_color, bg_cell)

    // 19 — WHO IS BUYING? headline
    f_cell(0, 19, "👥 WHO IS BUYING?", white_color, bg_section)
    f_cell(1, 19, show_who_buying ? who_state : "OFF", who_color, bg_cell)
    f_cell(2, 19, "ثقة", neutral_color, bg_section)
    f_cell(3, 19, show_who_buying ? who_confidence : "OFF", who_color, bg_cell)
    f_cell(4, 19, "Inst B " + str.tostring(institutional_buy_score) + " | R " + str.tostring(retail_buy_score), who_color, bg_cell)

    // 20 — institutional / retail score
    f_cell(0, 20, "🏦 مؤسسات شراء", neutral_color, bg_section)
    f_cell(1, 20, str.tostring(institutional_buy_score) + "/100", institutional_buy_score >= who_inst_threshold ? bull_color : yellow_color, bg_cell)
    f_cell(2, 20, "👤 أفراد شراء", neutral_color, bg_section)
    f_cell(3, 20, str.tostring(retail_buy_score) + "/100", retail_buy_score >= who_retail_threshold ? cyan_color : yellow_color, bg_cell)
    f_cell(4, 20, "Delta " + str.tostring(who_delta, "#") + " | CVD " + (who_cvd_bull ? "↑" : who_cvd_bear ? "↓" : "→"), who_cvd_bull ? bull_color : who_cvd_bear ? bear_color : yellow_color, bg_cell)

    // 21 — evidence
    f_cell(0, 21, "📊 Volume", neutral_color, bg_section)
    f_cell(1, 21, str.tostring(volume_ratio, "#.##") + "x", volume_ratio >= who_volume_threshold ? bull_color : neutral_color, bg_cell)
    f_cell(2, 21, "MFI", neutral_color, bg_section)
    f_cell(3, 21, str.tostring(who_mfi, "#.##"), who_mfi >= 55 ? bull_color : who_mfi <= 45 ? bear_color : yellow_color, bg_cell)
    f_cell(4, 21, "VWAP " + (who_vwap_bull ? "فوق" : who_vwap_bear ? "تحت" : "عليه"), who_vwap_bull ? bull_color : who_vwap_bear ? bear_color : yellow_color, bg_cell)

    // 22 — existing Smart Money
    f_cell(0, 22, "🧠 Smart Money", neutral_color, bg_section)
    f_cell(1, 22, smart_money_state, smart_money_color, bg_cell)
    f_cell(2, 22, "تجميع/تصريف", neutral_color, bg_section)
    f_cell(3, 22, "A " + str.tostring(accumulation_score) + " | D " + str.tostring(distribution_score), accumulation_score > distribution_score ? bull_color : distribution_score > accumulation_score ? bear_color : yellow_color, bg_cell)
    f_cell(4, 22, "Abs " + absorption_state + " | خطر " + manipulation_state, manipulation_risk >= 60 ? bear_color : manipulation_risk >= 35 ? yellow_color : neutral_color, bg_cell)

    // 23 — existing A/D phase
    f_cell(0, 23, "📊 مرحلة السوق", neutral_color, bg_section)
    f_cell(1, 23, ad_phase, ad_phase_color, bg_cell)
    f_cell(2, 23, "A/D", neutral_color, bg_section)
    f_cell(3, 23, "A " + str.tostring(ad_acc_score) + " | D " + str.tostring(ad_dist_score), ad_phase_color, bg_cell)
    f_cell(4, 23, "RV " + str.tostring(ad_rel_vol20, "#.##"), neutral_color, bg_cell)

    // 24 — existing Fake Breakout
    f_cell(0, 24, "⚠️ Fake Breakout", neutral_color, bg_section)
    f_cell(1, 24, ad_rise_diagnosis, ad_fake_score >= 60 ? bear_color : ad_confirmed_breakout ? bull_color : yellow_color, bg_cell)
    f_cell(2, 24, "خطر", neutral_color, bg_section)
    f_cell(3, 24, str.tostring(ad_fake_score) + "/100", ad_fake_score >= 60 ? bear_color : yellow_color, bg_cell)
    f_cell(4, 24, ad_fake_rise ? "تجنب المطاردة" : "راقب التأكيد", ad_fake_rise ? bear_color : neutral_color, bg_cell)

    // 25 — existing MTF
    f_cell(0, 25, "⏱ MTF", neutral_color, bg_section)
    f_cell(1, 25, ad_mtf_state, ad_mtf_color, bg_cell)
    f_cell(2, 25, "اختراق", neutral_color, bg_section)
    f_cell(3, 25, ad_confirmed_breakout ? "مؤكد نسبيًا" : "غير مؤكد", ad_confirmed_breakout ? bull_color : yellow_color, bg_cell)
    f_cell(4, 25, "H1 EMA20/50", ad_mtf_color, bg_cell)

    // 26 — participant evidence
    f_cell(0, 26, "🔬 دليل الحركة", neutral_color, bg_section)
    f_cell(1, 26, "CVD " + (who_cvd_bull ? "صاعد" : who_cvd_bear ? "هابط" : "محايد"), who_cvd_bull ? bull_color : who_cvd_bear ? bear_color : yellow_color, bg_cell)
    f_cell(2, 26, "CMF/OBV", neutral_color, bg_section)
    f_cell(3, 26, flow_confirm_bull ? "متفق ↑" : flow_confirm_bear ? "متفق ↓" : "متعارض", flow_confirm_bull ? bull_color : flow_confirm_bear ? bear_color : yellow_color, bg_cell)
    f_cell(4, 26, "Persistence " + str.tostring(who_delta_persistence, "#") + "%", who_delta_persistence >= 60 ? bull_color : who_delta_persistence <= 40 ? bear_color : yellow_color, bg_cell)

    // 27 — final interpretation
    f_cell(0, 27, "🎯 قراءة المتداول", white_color, bg_section)
    string who_action = institutional_buy_score >= who_inst_threshold ? "راقب التجميع المؤسسي" : institutional_sell_score >= who_inst_threshold ? "احذر التصريف المؤسسي" : retail_buy_score >= who_retail_threshold ? "شراء أفراد — لا تطارد" : retail_sell_score >= who_retail_threshold ? "بيع أفراد — انتظر" : "لا توجد هوية واضحة"
    f_cell(1, 27, who_action, who_color, bg_cell)
    f_cell(2, 27, "الموثوقية", neutral_color, bg_section)
    f_cell(3, 27, who_confidence, who_color, bg_cell)
    f_cell(4, 27, "ليس تحديد هوية حرفيًا", orange_color, bg_cell)

    // 28 — final dashboard reason
    string dashboard_reason = "📝 " + (show_money_flow ? "Flow: " + money_flow_state + " | Net: " + str.tostring(net_flow_m, "#.##") + "M\n" : "") + "WHO: " + who_state + " | Inst B " + str.tostring(institutional_buy_score) + " | Retail B " + str.tostring(retail_buy_score) + "\n" + analysis_reason
    table.merge_cells(dash, 0, 28, 4, 28)
    f_cell(0, 28, dashboard_reason, signal_color, bg_cell)

// ============================================================================ 
// 23) ALERTS
// ============================================================================ 

alertcondition(signal == "🟢 شراء قوي", title="شراء قوي", message="V60.1: إشارة شراء قوية على {{ticker}}")
alertcondition(signal == "🔴 تجنب", title="تجنب", message="V60.1: السهم سلبي {{ticker}}")
alertcondition(smart_buy, title="بصمة ميكر شرائية", message="V60.1: رصدت صفقات كبيرة شرائية على {{ticker}}")
alertcondition(smart_sell, title="بصمة ميكر بيعية", message="V60.1: رصدت صفقات كبيرة بيعية على {{ticker}}")
alertcondition(accumulation_phase, title="مرحلة تجميع", message="V60.1: السهم دخل في مرحلة تجميع {{ticker}}")
alertcondition(distribution_phase, title="مرحلة تصريف", message="V60.1: السهم دخل في مرحلة تصريف {{ticker}}")
alertcondition(fake_rise_warning, title="تحذير صعود وهمي", message="V60.1: تحذير صعود وهمي على {{ticker}}")
alertcondition(institutional_buy_score >= who_inst_threshold, title="شراء مؤسساتي محتمل", message="V60.1: شراء مؤسساتي محتمل على {{ticker}}")
alertcondition(institutional_sell_score >= who_inst_threshold, title="تصريف مؤسساتي محتمل", message="V60.1: تصريف مؤسساتي محتمل على {{ticker}}")
alertcondition(retail_buy_score >= who_retail_threshold and institutional_buy_score < who_inst_threshold, title="شراء أفراد محتمل", message="V60.1: شراء أفراد محتمل على {{ticker}}")